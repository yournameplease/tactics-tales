require("src/ui/ui_context_manager")

require("src/battle/tactics/enemy_ai")
require("src/joypad")



local ui_context = {}
local animation_manager
local ui_manager
local task_manager

local game

local service_manager


function _init()
   service_manager = ServiceManager.new()

   task_manager = service_manager:register(TaskManager.new())
   ui_manager = service_manager:register(UIManager.new())
   animation_manager = service_manager:register(AnimationManager.new())

   service_manager:register(EventBus.new())

   ui_context = UIContextManager.new()


   local game_services = {
      event_bus = service_manager.persistent_services.event_bus,
      task_manager = service_manager.persistent_services.task_manager,
      animation_manager = service_manager.persistent_services.animation_manager,
      ui_context = ui_context,
   }

   game = Game.new(game_services)
end

function _update()
   animation_manager:tick()
   LOG.trace("Getting Joypad.")
   local joy = get_joypad()
   game:update(joy)
   task_manager:update_tasks()
end

function _draw()
   animation_manager:generate_frame_data()
   ui_context:enrich()
   ui_manager:draw(ui_context)
end

