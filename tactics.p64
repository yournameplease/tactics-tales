:: build/debug.lua
local type = type; require("src/config")

LOG = {}

local log_level = CONFIG.LOG_LEVEL

local function should_print(level)
   if log_level == "ERROR" then
      return level == "ERROR"
   elseif log_level == "WARN" then
      return level == "WARN" or level == "ERROR"
   elseif log_level == "INFO" then
      return level == "INFO" or level == "WARN" or level == "ERROR"
   elseif log_level == "DEBUG" then
      return level ~= "TRACE"
   elseif log_level == "TRACE" then
      return true
   end
end


local function debug_print(level, ...)
   if should_print(level) then
      local array = { ... }
      local str = ""
      for i = 1, #array - 1 do
         local v = array[i]
         if type(v) == "boolean" then
            v = v and "TRUE" or "FALSE"
         end
         if type(v) == "string" then
            str = str .. v .. " , "
         elseif v == nil then
            str = str .. "<nil> , "
         else
            str = str .. tostring(v) .. " , "

         end
      end
      local v = array[#array]
      if type(v) == "boolean" then
         v = v and "TRUE" or "FALSE"
      end

      if type(v) == "string" then
         str = str .. v
      elseif v == nil then
         str = str .. "<nil> , "
      else
         str = str .. tostring(v)

      end

      printh(level .. ": " .. str)
   end
end

function LOG.error(...)
   debug_print("ERROR", ...)
end

function LOG.warn(...)
   debug_print("WARN", ...)
end

function LOG.info(...)
   debug_print("INFO", ...)
end

function LOG.debug(...)
   debug_print("DEBUG", ...)
end

function LOG.trace(...)
   debug_print("TRACE", ...)
end

return LOG

:: build/draw.lua
local draw_util = {}

function draw_shadow(c, draw, x, y)
   for i = 1, 31 do
      pal(i, c)
   end
   draw(x - 1, y)
   draw(x, y - 1)
   draw(x + 1, y)
   draw(x, y + 1)
   pal()
end

return draw_util

:: build/game_context.lua
require("src/ui/types")
require("src/battle/tactics/tactics_engine")
require("src/battle/battle_manager")
require("src/turn_manager")
require("src/battle/tile_manager")
require("src/menu/menu_manager")
require("src/character/character_manager")
require("src/systems/event_bus")
require("src/battle/combat/combat_calculator")



GameContext = {}

















function GameContext.new(
   battle_manager,
   turn_manager,
   character_manager,
   menu_manager,
   event_bus)

   local context = {
      battle_manager = battle_manager,
      tactics = battle_manager.tactics_engine,
      battle_state = battle_manager.battle_state,
      turn_manager = turn_manager,
      tile_manager = battle_manager.tactics_engine.tile_manager,
      character_manager = character_manager,
      menu_manager = menu_manager,
      event_bus = event_bus,
      combat_calculator = battle_manager.tactics_engine.combat_calculator,

      layout = "TACTICS",

      hovered_unit = nil,
      acting_unit = nil,
   }
   setmetatable(context, { __index = GameContext })
   return context
end

function GameContext:enrich()
   self.layout = "TACTICS"


   local selection = self.menu_manager.menu_selection

   if selection.type == "CURSOR_GRID" then
      if self.menu_manager.menu_state.step == "SELECT_UNIT" then
         local point = selection.point
         local unit = self.battle_state:get_at_tile(point)
         if unit then
            self.hovered_unit = unit
         end
      end

      if self.menu_manager.menu_state.step == "SELECT_TARGET" then
         local point = selection.point
         local unit = self.battle_state:get_at_tile(point)
         if unit then
            self.layout = "COMBAT_PREVIEW"
            self.hovered_unit = unit
         end
      end
   end

   if self.menu_manager.menu_ctx.acting_unit ~= nil then
      self.acting_unit = self.menu_manager.menu_ctx.acting_unit.unit
   end

   if self.menu_manager.menu_ctx.destination ~= nil then
      self.destination = self.menu_manager.menu_ctx.destination.point
   end

end

return GameContext

:: build/joypad.lua

Joypad = {}











function get_joypad()
   local joy = {

      dx = (btn(1) and 1 or 0) - (btn(0) and 1 or 0),
      dxp = (btnp(1) and 1 or 0) - (btnp(0) and 1 or 0),
      dy = (btn(3) and 1 or 0) - (btn(2) and 1 or 0),
      dyp = (btnp(3) and 1 or 0) - (btnp(2) and 1 or 0),
      a = btn(4),
      ap = btnp(4),
      b = btn(5),
      bp = btnp(5),
      lp = btnp(14),
   }

   return joy
end

:: build/main.lua





































require("src/systems/tasks")

require("src/debug")

require("src/systems/event_bus")

require("src/game_context")
require("src/turn_manager")
require("src/menu/menu_manager")
require("src/character/character_manager")
require("src/battle/combat/combat_calculator")
require("src/animation")
require("src/ui/ui_manager")
require("src/game_context")
require("src/battle/battle_manager")

require("src/battle/map/map_manager")

require("src/battle/tactics/enemy_ai")
require("src/joypad")



local context = {}
local animation_manager
local ui_manager
local task_manager

local battle_manager
local menu_manager

function _init()
   local a = TilePoint.of(1, 2)
   local b = TilePoint.of(2, 2)
   LOG.info(getmetatable(a).__add(a, b))

   LOG.info(a, b, a + b)

   task_manager = TaskManager.new()
   ui_manager = UIManager.new()
   animation_manager = AnimationManager.new()

   local event_bus = EventBus.new()

   local character_manager = CharacterManager.new(event_bus)
   LOG.debug(character_manager.id_counter:get_id())

   battle_manager = BattleManager.new("bandit_village", event_bus, character_manager, animation_manager, task_manager)
   local tactics_engine = battle_manager.tactics_engine
   local tile_manager = battle_manager.tile_manager
   local battle_state = battle_manager.battle_state

   menu_manager = MenuManager.new(tactics_engine, battle_state, tile_manager, event_bus)
   local enemy_ai_engine = EnemyAIEngine.new(battle_manager, battle_state, tactics_engine, event_bus, task_manager, tile_manager)

   local turn_manager = TurnManager.new(event_bus, tactics_engine, battle_manager, menu_manager, enemy_ai_engine)



   context = GameContext.new(
   battle_manager,
   turn_manager,
   character_manager,
   menu_manager,
   event_bus)


   event_bus:emit("TACTICS_BEGIN_BATTLE")
end

function _update()
   LOG.trace("Getting Joypad.")
   local joy = get_joypad()
   LOG.trace("Updating menus.")
   menu_manager:update(joy)
   LOG.trace("Updating battle.")
   battle_manager:update()
   LOG.trace("Ticking animations.")
   animation_manager:tick()
   LOG.trace("Enriching context.")
   context:enrich()
   LOG.trace("Updating tasks.")
   task_manager:update_tasks()
end

function _draw()
   LOG.trace("Generating frame data.")
   animation_manager:generate_frame_data()
   LOG.trace("Drawing UI.")
   ui_manager:draw(context)
end

