local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/debug")
require("src/types")
require("src/menu/types")
require("src/menu/menu_manager")
require("src/battle/tactics/tactics_engine")
require("src/joypad")
require("src/battle/pathfinding")
require("src/systems/service")
require("src/menu/menu_manager")
require("src/battle/battle_context")

require("src/menu/cursor/grid_cursor")
require("src/menu/cursor/list_cursor")


BattleMenuManager = {}






local MENU_DATA = {
   ["MENU_PLAYER_TURN"] = {
      initial_step = "SELECT_UNIT",
      steps = {
         ["SELECT_UNIT"] = GridMenuDefinition.new({
            set_selected_context = function(s, msb, ctx)
               ctx.acting_unit = { unit = msb.battle_map:get_at_tile(s.point) }
            end,
            validator = function(s, msb, _ctx)
               return msb.tactics_engine:grid_selection_is_available_player(s) end,
            next_state = "SELECT_DESTINATION",
         }),
         ["SELECT_DESTINATION"] = GridMenuDefinition.new({
            set_selected_context = function(s, _msb, ctx)
               ctx.destination = { point = s.point:copy(), path = s.path }
            end,
            validator = function(s, msb, ctx)
               return msb.tactics_engine:grid_selection_is_empty_or_acting_unit(s, ctx) and
               s.legal_tiles:get_point(s.point) ~= nil and
               s.legal_tiles:get_point(s.point).valid_selection
            end,
            next_state = "SELECT_ACTION",
            previous_state = "SELECT_UNIT",
            get_legal_tiles = function(msb, ctx)
               return msb.tactics_engine:tiles_in_movement_and_attack_range(ctx)
            end,
         }),
         ["SELECT_ACTION"] = ListMenuDefinition.new({
            previous_state = "SELECT_DESTINATION",
            get_options = function(msb, ctx)
               local options = {}

               if msb.tactics_engine:any_target_in_range(ctx) then
                  pt.add(options, {
                     text = "Attack",
                     next_state = "SELECT_TARGET",
                  })
               end

               pt.add(options, {
                  text = "Wait",
                  send_command = "MOVE_AND_WAIT",
               })

               pt.add(options, {
                  text = "Items",
                  next_state = "SELECT_ITEM",
               })

               return options
            end,
         }),
         ["SELECT_TARGET"] = GridMenuDefinition.new({
            previous_state = "SELECT_ACTION",
            set_selected_context = function(s, msb, ctx)
               ctx.target_unit = { unit = msb.battle_map:get_at_tile(s.point) }
            end,
            validator = function(s, msb, ctx)
               return msb.tactics_engine:validate_tile_is_in_unit_attack_range(s, ctx)
            end,
            send_command = "MOVE_AND_ATTACK",
            get_legal_tiles = function(msb, ctx)
               return msb.tactics_engine:tiles_with_distance_from_unit_attacks(ctx)
            end,
         }),
         ["SELECT_ITEM"] = ListMenuDefinition.new({
            previous_state = "SELECT_ACTION",
            set_selected_context = function(s, _msb, ctx)
               ctx.selected_item = {
                  index = s.i,
                  item = ctx.acting_unit.unit.character.inventory:get_items()[s.i],
               }
            end,
            get_options = function(_msb, ctx)
               local character = ctx.acting_unit.unit
               local items = character.character.inventory:get_items()

               local options = {}
               for i, item in ipairs(items) do
                  pt.add(options, {
                     text = item:get_name(),
                     next_state = "SELECT_ITEM_ACTION",
                  })
               end
               return options
            end,
         }),
         ["SELECT_ITEM_ACTION"] = ListMenuDefinition.new({
            previous_state = "SELECT_ITEM",
            get_options = function(_msb, ctx)
               local character = ctx.acting_unit.unit
               local inventory = character.character.inventory
               local items = inventory:get_items()
               local item = ctx.selected_item.item
               local index = ctx.selected_item.index

               if inventory:get_items()[index] == nil then
                  return {}
               end

               local options = {}


               if item:get_equip_slot() ~= "NONE" then
                  if inventory:is_equipped(index) then
                     pt.add(options, {
                        text = "Unequip",
                        send_command = "INVENTORY_UNEQUIP_ITEM",
                        next_state = "SELECT_ITEM_ACTION",
                     })
                  else
                     pt.add(options, {
                        text = "Equip",
                        send_command = "INVENTORY_EQUIP_ITEM",
                        next_state = "SELECT_ITEM_ACTION",
                     })
                  end
               end

               if #items > 0 then
                  pt.add(options, {
                     text = "Move",
                  })
               end
               pt.add(options, {
                  text = "Discard",
                  send_command = "INVENTORY_DISCARD_ITEM",
                  next_state = "SELECT_ITEM",
               })

               return options
            end,
         }),
      },
   },
}

function BattleMenuManager.new(ctx)
   return BaseMenuManager.new(
   MENU_DATA,
   ctx)

end

return BattleMenuManager

:: build/battle/battle_objective_service.lua

require("src/systems/service")
require("src/systems/event_bus")
require("src/battle/battle_map")
require("src/battle/battle_context")
require("src/battle/tactics/tactics_engine")

BattleObjectiveService = {}



function BattleObjectiveService.new(ctx)
   local self = setmetatable({
      ctx = ctx,
   }, { __index = BattleObjectiveService })

   return self
end

BattleFinishState = {}





function BattleObjectiveService:check_for_end()
   if self.ctx.tactics_engine:is_blocked() then
      return { finished = false }
   end

   local players = self.ctx.battle_map:get_units(unit_is_player)
   local enemies = self.ctx.battle_map:get_units(unit_is_enemy)

   if (#players == 0) then
      return { finished = true, command = "BATTLE_END_VICTORY" }
   elseif (#enemies == 0) then
      return { finished = true, command = "BATTLE_END_DEFEAT" }
   else
      return { finished = false }
   end
end



function BattleObjectiveService:check_objectives()

   return self:check_for_end()
end

return BattleObjectiveService

