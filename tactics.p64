         sprite_offset = 2,
         anchors = {
            neck = AnimationAnchorPoint.of(7, 7),
            main_hand = AnimationAnchorPoint.of(3, 12),
            off_hand = AnimationAnchorPoint.of(12, 12),
            feet_center = AnimationAnchorPoint.of(7, 15),
         },
      },
      walk_2 = {
         sprite_offset = 3,
         anchors = {
            neck = AnimationAnchorPoint.of(7, 7),
            main_hand = AnimationAnchorPoint.of(3, 12),
            off_hand = AnimationAnchorPoint.of(12, 12),
            feet_center = AnimationAnchorPoint.of(7, 15),
         },
      },
   },
   FRONT_HAND = {
      idle_1 = {
         sprite_offset = 0,
         anchors = {
            neck = AnimationAnchorPoint.of(6, 7),
            main_hand = AnimationAnchorPoint.of(13, 9),
            off_hand = AnimationAnchorPoint.of(3, 11),
            feet_center = AnimationAnchorPoint.of(7, 15),
         },
      },
      idle_2 = {
         sprite_offset = 1,
         anchors = {
            neck = AnimationAnchorPoint.of(7, 7),
            main_hand = AnimationAnchorPoint.of(14, 8),
            off_hand = AnimationAnchorPoint.of(4, 11),
            feet_center = AnimationAnchorPoint.of(7, 15),
         },
      },
      walk_1 = {
         sprite_offset = 2,
         anchors = {
            neck = AnimationAnchorPoint.of(6, 7),
            main_hand = AnimationAnchorPoint.of(13, 9),
            off_hand = AnimationAnchorPoint.of(3, 11),
            feet_center = AnimationAnchorPoint.of(7, 15),
         },
      },
      walk_2 = {
         sprite_offset = 3,
         anchors = {
            neck = AnimationAnchorPoint.of(6, 7),
            main_hand = AnimationAnchorPoint.of(13, 9),
            off_hand = AnimationAnchorPoint.of(3, 11),
            feet_center = AnimationAnchorPoint.of(7, 15),
         },
      },
   },
}

local function frame_from_base_frame(s, base_frame)
   local frame = {
      sprite = s + base_frame.sprite_offset,
      anchors = base_frame.anchors,
   }
   return frame
end

local function frames_from_base_frame(s, base_frame)
   return tmap(BASE_FRAMES[base_frame], function(f) return frame_from_base_frame(s, f) end)
end

local ANIMATION_DATA = {
   DEFAULT_BACK_HAND = frames_from_base_frame(128, "BACK_HAND"),
   DEFAULT_HORIZONTAL = frames_from_base_frame(136, "HORIZONTAL"),
   DEFAULT_FRONT_HAND = frames_from_base_frame(144, "FRONT_HAND"),
   SLEEVELESS_BACK_HAND = frames_from_base_frame(160, "BACK_HAND"),
   SLEEVELESS_HORIZONTAL = frames_from_base_frame(168, "HORIZONTAL"),
   SLEEVELESS_FRONT_HAND = frames_from_base_frame(176, "FRONT_HAND"),
   SHIRTLESS_BACK_HAND = frames_from_base_frame(192, "BACK_HAND"),
   SHIRTLESS_HORIZONTAL = frames_from_base_frame(198, "HORIZONTAL"),
   SHIRTLESS_FRONT_HAND = frames_from_base_frame(206, "FRONT_HAND"),
   ROBED_BACK_HAND = frames_from_base_frame(224, "BACK_HAND"),
   ROBED_HORIZONTAL = frames_from_base_frame(232, "HORIZONTAL"),
   ROBED_FRONT_HAND = frames_from_base_frame(240, "FRONT_HAND"),
}

return ANIMATION_DATA

:: build/character/character_generator.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/data/character_templates")
require("src/character/object/character")
require("src/data/items")
require("src/character/items/object/weapon")
require("src/util")
local Item = require("src/character/items/object/item")
local ItemInventory = require("src/character/items/object/item_inventory")
local ItemGenerator = require("src/character/items/item_generator")
local NAMES = require("src/corpora/names")

local CharacterGenerator = {}


local function apply_template_to_parent(parent, child)
   return {
      movement = child.movement or parent.movement,
      hp_max = child.hp_max or parent.hp_max,
      item_loadout_options = child.item_loadout_options or parent.item_loadout_options,
      eyewear_options = child.eyewear_options or parent.eyewear_options,
      headwear_options = child.headwear_options or parent.headwear_options,
      body_options = child.body_options or parent.body_options,
      sex_options = child.sex_options or parent.sex_options,
      skin_color_options = child.skin_color_options or parent.skin_color_options,
      hair_color_options = child.hair_color_options or parent.hair_color_options,
      hair_options_m = child.hair_options_m or parent.hair_options_m,
      hair_options_f = child.hair_options_f or parent.hair_options_f,
      beard_options = child.beard_options or parent.beard_options,
      eye_options = child.eye_options or parent.eye_options,
   }
end

local function build_template(template_id)
   if template_id == nil then
      return apply_template_to_parent({}, UNIT_TEMPLATES["default"])
   end

   local template_definition = UNIT_TEMPLATES[template_id]
   local template_parent = build_template(template_definition.parent_template)
   return apply_template_to_parent(template_parent, template_definition)
end

function CharacterGenerator.generate_from_template(id, template_id)
   LOG.debug("Generating from template ", template_id)
   local template = build_template(template_id)
   local character = {
      id = id,
      appearance = {},
      stats = {},
   }

   character.stats.movement = template.movement
   character.stats.hp_max = template.hp_max
   character.stats.def = 0
   character.appearance.eyewear = template.eyewear_options:pick_random()
   character.appearance.headwear = template.headwear_options:pick_random()
   character.appearance.body_class = template.body_options:pick_random()
   character.appearance.sex = template.sex_options:pick_random()
   character.appearance.skin = template.skin_color_options:pick_random()
   repeat
      character.appearance.hair_color = template.hair_color_options:pick_random()
   until character.appearance.hair_color ~= SKIN_COLORS[character.appearance.skin][1]
   character.appearance.head = character.appearance.sex == "male" and 64 or 68
   if character.appearance.sex == "male" then
      character.appearance.hair = template.hair_options_m:pick_random()
      character.appearance.beard = template.beard_options:pick_random()
   else
      character.appearance.hair = template.hair_options_f:pick_random()
   end
   character.appearance.eyes = template.eye_options:pick_random()

   character.name = character.appearance.sex == "male" and
   choose_random_from_list(NAMES.MALE) or
   choose_random_from_list(NAMES.FEMALE)

   character.inventory = ItemInventory.new(4)
   local item_ids = template.item_loadout_options:pick_random()
   for i, item_id in ipairs(item_ids) do
      local item = ItemGenerator.generate(item_id)
      if character.inventory:can_add_item(item) then
         character.inventory:add_item(item)
         if character.inventory:can_equip(i) then
            character.inventory:equip_item(i)
         end
      end
   end

   return setmetatable(character, { __index = Character })
end

return CharacterGenerator

:: build/character/character_manager.lua
require("src/debug")
require("src/util")
require("src/systems/event_bus")
require("src/menu/types")
require("src/character/animation_data")
require("src/character/items/object/weapon")
require("src/animation")
require("src/character/object/character")
local CharacterGenerator = require("src/character/character_generator")



CharacterManager = {}






function CharacterManager:generate_character(template_id)
   local character = CharacterGenerator.generate_from_template(
   self.id_counter:get_id(),
   template_id)


   self.characters[character.id] = character

   return character
end



function CharacterManager:handle_equip_item(ctx)
   local character = ctx.acting_unit.unit.character
   local item_index = ctx.selected_item.index
   character.inventory:equip_item(item_index)
end

function CharacterManager:handle_unequip_item(ctx)
   local character = ctx.acting_unit.unit.character
   local item_index = ctx.selected_item.index
   character.inventory:unequip_item(item_index)
end

function CharacterManager:handle_discard_item(ctx)
   local character = ctx.acting_unit.unit.character
   local item_index = ctx.selected_item.index
   character.inventory:remove_item(item_index)
end

function CharacterManager.new(
   event_bus)

   local self = setmetatable({}, { __index = CharacterManager })
   self.id_counter = IdCounter.new()
   self.characters = {}

   self.event_bus = event_bus

   self.event_bus:on("INVENTORY_EQUIP_ITEM", function(ctx)
      self:handle_equip_item(ctx)
   end)
   self.event_bus:on("INVENTORY_UNEQUIP_ITEM", function(ctx)
      self:handle_unequip_item(ctx)
   end)
   self.event_bus:on("INVENTORY_DISCARD_ITEM", function(ctx)
      self:handle_discard_item(ctx)
   end)

   return self
end

return CharacterManager

:: build/character/character_renderer.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local pairs = _tl_compat and _tl_compat.pairs or pairs; require("src/debug")
require("src/types")

require("src/battle/tactics/battle_unit")
require("src/character/character_manager")
require("src/character/object/character")
require("src/character/sprite_data")

local ANIMATION_DATA = require("src/character/animation_data")

local BASE_UNIT_SPRITE = 256

local COLOR_SKIN = 29
local COLOR_SKIN_SHADOW = 13
local COLOR_HAIR = 23
local COLOR_BEARD = 22
local _COLOR_EYE = 21
local _COLOR_EYE_WHITE = 7

local CharacterRenderer = {}



local function get_anchor_offsets(base, anchor, child, flip_h, flip_v)
   local diff_x = anchor.x - child.x
   local diff_y = anchor.y - child.y
   if flip_h then diff_x = -diff_x end
   if flip_v then diff_y = -diff_y end

   return { x = base.x + diff_x, y = base.y + diff_y }
end

local function get_body_type(battle_unit)

   local base_body_type = "BACK_HAND"
   local body_class = battle_unit.character.appearance.body_class
   if battle_unit.character.appearance.sex == "female" and body_class == "SHIRTLESS" then
      body_class = "SLEEVELESS"
   end


   return (body_class .. "_" .. base_body_type)
end







local function get_animation_frame(battle_unit)
   local frame_name
   local offset
   if battle_unit.animation_data ~= nil and battle_unit.animation_data.current_frame ~= nil then
      frame_name = battle_unit.animation_data.current_frame.frame
      offset = battle_unit.animation_data.current_frame.offset
   else
      LOG.debug("Unrecognized animation frame.")
      frame_name = "idle_1"
      offset = { x = 0, y = 0 }
   end

   local animation_frame = ANIMATION_DATA[get_body_type(battle_unit)][frame_name]

   return {
      offset = offset,
      sprite = BASE_UNIT_SPRITE + animation_frame.sprite,
      anchors = animation_frame.anchors,
   }
end


function CharacterRenderer.get_animation_offset(battle_unit)
   local frame_data = get_animation_frame(battle_unit)

   return { x = frame_data.offset.x + frame_data.anchors.feet_center.x,
y = frame_data.offset.y + frame_data.anchors.feet_center.y, }
end

local function set_palette(battle_unit, side)
   if side == 1 then
      pal(16, 8)
      pal(19, 24)
   end
   local skin = battle_unit.character.appearance.skin
   pal(COLOR_SKIN, SKIN_COLORS[skin][1])
   pal(COLOR_SKIN_SHADOW, SKIN_COLORS[skin][2])
   pal(COLOR_HAIR, battle_unit.character.appearance.hair_color)
   pal(COLOR_BEARD, battle_unit.character.appearance.hair_color)
end

function CharacterRenderer.draw_head(battle_unit, point, side, set_pal)
   local flip_h = side ~= 0

   if set_pal then
      set_palette(battle_unit, side)
   end

   local headwear = nil
   if battle_unit.character.appearance.headwear then
      headwear = HEADWEAR_SPRITE_DATA[battle_unit.character.appearance.headwear]
   end

   spr(BASE_UNIT_SPRITE + battle_unit.character.appearance.head, point.x, point.y, flip_h)

   if headwear == nil or headwear.draw_beard then
      if battle_unit.character.appearance.beard ~= nil then
         spr(BASE_UNIT_SPRITE + battle_unit.character.appearance.beard, point.x, point.y, flip_h)
      end
   end
   if headwear == nil or headwear.draw_eyewear then
      spr(BASE_UNIT_SPRITE + battle_unit.character.appearance.eyes, point.x, point.y, flip_h)
      if battle_unit.character.appearance.eyewear ~= nil then
         spr(BASE_UNIT_SPRITE + battle_unit.character.appearance.eyewear, point.x, point.y, flip_h)
      end
   end
   if headwear == nil or headwear.draw_hair then
      spr(BASE_UNIT_SPRITE + battle_unit.character.appearance.hair, point.x, point.y, flip_h)
   end
   if headwear ~= nil then
      spr(BASE_UNIT_SPRITE + headwear.sprite, point.x, point.y, flip_h)
   end

end

function CharacterRenderer.draw(battle_unit, point, side, set_pal, apply_animation)

   local flip_h = side ~= 0

   local animation_frame = get_animation_frame(battle_unit)

   local offset = animation_frame.offset
   if not apply_animation then
      offset = AnimationOffset.of(0, 0)
   end

   local base_point = get_anchor_offsets(
   point + offset,
   AnimationAnchorPoint.of(0, 0),
   animation_frame.anchors.feet_center,

   false,
   false)


   local HEAD_NECK_X = 9
   local HEAD_NECK_Y = 7

   if set_pal then
      set_palette(battle_unit, side)
   end

   spr(animation_frame.sprite, base_point.x, base_point.y, flip_h)

   local head_anchor = get_anchor_offsets(base_point, animation_frame.anchors.neck, { x = HEAD_NECK_X, y = HEAD_NECK_Y }, flip_h, false)
   CharacterRenderer.draw_head(battle_unit, head_anchor, side, set_pal)

   local equipment = battle_unit.character.inventory:get_equipped_items()
   for slot, equip in pairs(equipment) do
      if slot == "BODY" then

      else
         if equip:get_sprite_data() ~= nil then
            local anchor = slot == "OFF_HAND" and "off_hand" or "main_hand"
            local equip_anchor = get_anchor_offsets(base_point, animation_frame.anchors[anchor], equip:get_sprite_data().anchor, flip_h, false)
            spr(BASE_UNIT_SPRITE + equip:get_sprite_data().sprite, equip_anchor.x, equip_anchor.y, flip_h)
         end
      end
   end

   if set_pal then
      pal()
   end

end

return CharacterRenderer

