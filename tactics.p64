local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/ui/box")
require("src/ui/components/text_node")
require("src/ui/panels/portrait_box")
require("src/character/items/object/item")
require("src/ui/ui_context_manager")
require("src/character/items/object/item_inventory")
require("src/battle/battle_context")

UnitInfo = {}



setmetatable(UnitInfo, { __index = Box })

function UnitInfo.new(props)
   props.dir = "row"
   props.gap = props.gap or 4
   props.padding = props.padding or 4
   props.auto_height = props.auto_height or true

   local self = Box.new(props)
   setmetatable(self, { __index = UnitInfo })

   local left = self:add(Box.flex_col())
   left:add(PortraitBox.new(function(state) return state.battle_context.hovered_unit end))
   left:add(Box.spacer())

   local info_col = self:add(Box.new({
      auto_height = true,
      flex_grow = 1,
      dir = "col",
      gap = 2,
   }))


   info_col:add(TextNode.new({
      func = function(state)
         local u = state.battle_context.hovered_unit
         if not u then return { "No Unit Selected" } end
         return { u.character.name .. " Lv." .. 1 }
      end,
   }))


   info_col:add(TextNode.new({
      rows = 3,
      func = function(state)
         local u = state.battle_context.hovered_unit
         if not u then return { "", "", "" } end

         local weapons = u.character.inventory:get_equipped_weapons()

         local w
         if #weapons > 0 then
            w = weapons[1]
         end

         return {
            "HP: " .. u.hp_current .. "/" .. u.character.stats.hp_max,
            w and w.name or "Unarmed",
            w and ("(" .. w.accuracy .. "% for " .. w.damage .. " dmg)") or "",
         }
      end,
   }))

   info_col:add(TextNode.new({
      rows = 5,
      func = function(state)
         local u = state.battle_context.hovered_unit
         if not u then return { "", "", "", "", "" } end

         local items = u.character.inventory:get_items()

         local out = { "Inventory:", "", "", "", "" }

         local index = 1
         for _, item in ipairs(items) do
            out[index + 1] = item:get_name()
            index = index + 1
            for _ = 2, item:get_slots() do
               out[index + 1] = " |"
               index = index + 1
            end
         end

         return out
      end,
   }))

   return self
end

return UnitInfo

:: build/ui/panels/vertical_list_menu.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/debug")
require("src/ui/box")
require("src/systems/event_bus")
require("src/ui/components/text_node")
require("src/ui/ui_context_manager")
require("src/story/story_context")
require("src/menu/cursor/list_cursor")
local String = require("src/util/string")

local VerticalListMenu = {}






function VerticalListMenu.new(
   unselected_template,
   selected_template,
   menu_cursor_func,
   props)


   props.func = function(state)
      local out = {}
      local cursor = menu_cursor_func(state)
      local selected = cursor.i
      LOG.trace("rendering options: ", #cursor.options, selected)
      for i, opt in ipairs(cursor.options) do
         local template = i == selected and selected_template or unselected_template
         local out_line = String.format(template, { ["text"] = opt.text })
         LOG.trace("out line", template, out_line)
         pt.add(out, out_line)
      end
      return out
   end

   props.draw_properties = props.draw_properties or {}
   props.draw_properties.text_direction = props.draw_properties.text_direction or 'down'
   return TextNode.new(props)
end

return VerticalListMenu

