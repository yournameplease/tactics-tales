:: build/character/items/object/item_inventory.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; local Item = require("src/character/items/object/item")
require("src/character/items/types")
require("src/character/items/object/weapon")
local List = require("src/util/list")
require("src/util")

local ItemInventoryModule = {}






























local ItemInventoryImpl = {}











function ItemInventoryImpl:compute_current_slots()
   self._items_by_slot = {}
   self._items_by_equip_slot = {}
   local count = 1
   for _, item in ipairs(self.items) do
      item._current_slot = count
      self._items_by_slot[count] = item
      if (item.equip_slot) ~= nil then
         self._items_by_equip_slot[item.equip_slot] = item
      end
      count = count + item.item:get_slots()
   end
   self._current_slot_usage = count
end

function ItemInventoryImpl:get_items()
   return List.do_map(
   self.items,
   function(i)
      return i.item
   end)

end

function ItemInventoryImpl:get_items_by_slot()
   return tmap(
   self._items_by_slot,
   function(i)
      return i.item
   end)

end

function ItemInventoryImpl:get_max_slots()
   return self.max_slots
end

function ItemInventoryImpl:get_equipped_items()
   return tmap(
   self._items_by_equip_slot,
   function(i)
      return i.item
   end)

end

function ItemInventoryImpl:get_equipped_weapons()
   local out = {}
   if self._items_by_equip_slot["TWO_HANDS"] ~= nil and
      self._items_by_equip_slot["TWO_HANDS"].item:get_type() == "WEAPON" then
      add(out, self._items_by_equip_slot["TWO_HANDS"].item:get_weapon_data())
   end
   if self._items_by_equip_slot["MAIN_HAND"] ~= nil and
      self._items_by_equip_slot["MAIN_HAND"].item:get_type() == "WEAPON" then
      add(out, self._items_by_equip_slot["MAIN_HAND"].item:get_weapon_data())
   end
   if self._items_by_equip_slot["OFF_HAND"] ~= nil and
      self._items_by_equip_slot["OFF_HAND"].item:get_type() == "WEAPON" then
      add(out, self._items_by_equip_slot["OFF_HAND"].item:get_weapon_data())
   end
   return out
end

function ItemInventoryImpl:can_equip(index)
   local equip_slot = self.items[index].item:get_equip_slot()
   if equip_slot == "TWO_HANDS" then
      return self._items_by_equip_slot.MAIN_HAND == nil and
      self._items_by_equip_slot.OFF_HAND == nil and
      self._items_by_equip_slot.TWO_HANDS == nil
   elseif equip_slot == "MAIN_HAND" then
      return self._items_by_equip_slot.MAIN_HAND == nil and
      self._items_by_equip_slot.TWO_HANDS == nil
   elseif equip_slot == "OFF_HAND" then
      return self._items_by_equip_slot.OFF_HAND == nil and
      self._items_by_equip_slot.TWO_HANDS == nil
   elseif equip_slot == "BODY" then
      return self._items_by_equip_slot.BODY == nil
   end
   return false
end

function ItemInventoryImpl:is_equipped(index)
   return self.items[index].equip_slot ~= nil
end

function ItemInventoryImpl:can_add_item(item)
   return self._current_slot_usage + item:get_slots() <= self.max_slots
end

function ItemInventoryImpl:add_item(item)
   assert(self:can_add_item(item))
   add(self.items, { item = item })
   self:compute_current_slots()
end

function ItemInventoryImpl:equip_item(index)
   local inventory_item = self.items[index]

   local slot_to_equip = inventory_item.item:get_equip_slot()
   assert(slot_to_equip ~= "NONE")
   assert(slot_to_equip ~= "ANY_HAND", "NOT IMPLEMENTED")

   local slots_to_unequip
   if slot_to_equip == "MAIN_HAND" then
      slots_to_unequip = { "MAIN_HAND", "TWO_HANDS" }
   elseif slot_to_equip == "OFF_HAND" then
      slots_to_unequip = { "OFF_HAND", "TWO_HANDS" }
   elseif slot_to_equip == "TWO_HANDS" then
      slots_to_unequip = { "MAIN_HAND", "OFF_HAND", "TWO_HANDS" }
   elseif slot_to_equip == "BODY" then
      slots_to_unequip = { "MAIN_HAND", "TWO_HANDS" }
   else
      error()
   end


   for _, s in ipairs(slots_to_unequip) do
      self:unequip_item_in_equip_slot(s)
   end

   inventory_item.equip_slot = slot_to_equip
   self._items_by_equip_slot[slot_to_equip] = inventory_item
end

function ItemInventoryImpl:unequip_item_in_equip_slot(slot)
   if (self._items_by_equip_slot[slot] ~= nil) then
      self._items_by_equip_slot[slot].equip_slot = nil
      self._items_by_equip_slot[slot] = nil
   end
end

function ItemInventoryImpl:unequip_item(index)
   local equip_slot = self.items[index].equip_slot
   self:unequip_item_in_equip_slot(equip_slot)
end

function ItemInventoryImpl:remove_item(slot)
   local item = self._items_by_slot[slot]
   del(self.items, item)
   self:compute_current_slots()
end

function ItemInventoryImpl:move_item(index, before_index)
   error("not implemented")

   self:compute_current_slots()
end

function ItemInventoryModule.new(max_slots)
   local inventory = {
      max_slots = max_slots,
      items = {},
   }
   setmetatable(inventory, { __index = ItemInventoryImpl })
   inventory:compute_current_slots()
   return inventory
end

return ItemInventoryModule

