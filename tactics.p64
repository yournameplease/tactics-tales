--[[pod_format="raw",created="2025-11-19 14:13:42",modified="2025-11-20 01:41:01",revision=25]]


local ANIMATIONS = {
	["BUMP"] = {
		duration = 10,
		track = { -- list of offsets
			0, 1, 4,12, 15, 16, 15, 12, 4, 1, 0
		}
	},
	["DODGE"] = {
		duration = 10,
		track = { -- list of offsets
			0, 1, 4,12, 15, 16, 15, 12, 4, 1, 0
		}
	},
	["HURT"] = {
		duration = 10,
		track = { -- list of offsets
			0, 0, 0, 0, 4, 6, 6, 6, 4, 2, 0
		}
	},
	["DEATH"] = {
		duration = 10,
		track = { -- list of offsets
			0, 1, 4,12, 12, 12, 12, 12, 12, 12, 12
		}
	}
}

-- animation_data
-- frame
-- animation_id
-- direction

function create_animation(animation_id, direction)
	local animation_data = {
		id = animation_id,
		frame = 1,
		direction = direction,
		playing = true
	}
	
	return animation_data
end

function update_animation(animation_data)
	if animation_data.frame >= #(ANIMATIONS[animation_data.id].track) then
		animation_data.playing = false
	else
		animation_data.frame = animation_data.frame + 1
	end
end

function get_x_y_from_animation(animation_data)
	if animation_data == nil then return 0, 0 end

	local track = ANIMATIONS[animation_data.id].track
	assert(animation_data.frame <= #track)
	
	local direction = animation_data.direction
	local offset = track[animation_data.frame]
	return offset * cos(direction), offset * sin(direction)
end
:: character.lua
--[[pod_format="raw",created="2025-11-18 04:01:30",modified="2025-11-20 01:20:55",revision=71]]
include "util.lua"
include "animation.lua"

local COLOR_SKIN = 4
local COLOR_SKIN_SHADOW = 20
local COLOR_HAIR = 23
local COLOR_BEARD = 22
local COLOR_EYE = 21
local COLOR_EYE_WHITE = 7

local HAIR_COLORS = {
	4, 5, 6, 9, 10, 20, 21, 22, 24, 25, 31 
}
local SKIN_COLORS = {
	{15, 31},
	{31, 4},
	{4, 20},
	{20, 21}
}

local BASE_HEAD_SPRITE = 256 + 64
local BASE_M_HAIR_SPRITE = 256 + 72
local BASE_F_HAIR_SPRITE = 256 + 80
local BASE_BEARD_SPRITE = 256 + 88
local BASE_BODY_SPRITE = 256 + 96
local BASE_WEAPON_SPRITE = 256 + 104

Character = {}

function Character:take_damage(amount)
	local new_hp = mid(0, self.stats.hp_current - amount, self.stats.hp_max)
	self.stats.hp_current = new_hp
end

function Character:die()

end

function Character:start_animation(animation_id, direction)
	self.animation_data = create_animation(animation_id, direction)
	self.animation_playing = true
end

function Character:update_animation()
	if self.animation_data == nil then return end
	update_animation(self.animation_data)
	self.animation_playing = self.animation_data.playing
end

function Character:draw(x, y, side, set_pal)
	-- TODO: consider pre-rendering some of this
	local flip_h = side ~= 0
	local sex = self.appearance.sex
	
	local o_x, o_y = get_x_y_from_animation(self.animation_data) 
	x = x + o_x
	y = y + o_y
	
	spr(BASE_WEAPON_SPRITE, x, y, flip_h)
	
	if set_pal then
		if side == 1 then 
			pal(16, 8)
			pal(19, 24)
		end
		local skin = self.appearance.skin
		pal(COLOR_SKIN, SKIN_COLORS[skin][1])
		pal(COLOR_SKIN_SHADOW, SKIN_COLORS[skin][2])
		pal(COLOR_HAIR, self.appearance.hair_color)
		pal(COLOR_BEARD, self.appearance.beard_color)
	end
	spr(BASE_BODY_SPRITE + 4 * sex + self.appearance.body, x, y, flip_h)
	spr(BASE_HEAD_SPRITE + 4 * sex, x, y, flip_h)
	if sex == 0 then
		spr(BASE_M_HAIR_SPRITE + self.appearance.hair, x, y, flip_h)
	else
		spr(BASE_F_HAIR_SPRITE + self.appearance.hair, x, y, flip_h)
	end
	if self.appearance.beard ~= nil then
		spr(BASE_BEARD_SPRITE + self.appearance.beard, x, y, flip_h)
	end
	if set_pal then
		pal()
	end
	
end

function generate_appearance()
	local appearance = {}
	
	appearance.sex = rndi(2)
	appearance.hair = rndi(6)
	appearance.skin = rndi(#SKIN_COLORS)+1
	while appearance.hair_color == nil 
		or appearance.hair_color == SKIN_COLORS[appearance.skin][1]
		do
		appearance.hair_color = choose_random_from_list(HAIR_COLORS)
	end
	
	if appearance.sex == 0 then -- male
		appearance.body = flr(rnd(6)/5)
		appearance.beard = rndi(6)
		if rnd(6) <= 1 then
			appearance.beard_color = choose_random_from_list(HAIR_COLORS)
		else
			appearance.beard_color = appearance.hair_color
		end
	else -- female
		appearance.body = rndi(2)
	end
	
	return appearance
end

function generate_character()
	local character = {
		appearance = generate_appearance(),
		s = 264,
		stats = {
			hp_max = 10,
			hp_current = 10,
			damage = 5,
			min_range = 1,
			max_range = 1
		},
		animation_playing = false
	}
	
	setmetatable(character, { __index = Character })
	
	return character
end

:: combat.lua
--[[pod_format="raw",created="2025-11-18 04:56:26",modified="2025-11-20 01:37:12",revision=31]]
include "tasks.lua"

function is_in_combat_range(attacker, defender)
	local a_x = attacker.tactics_data.x
	local a_y = attacker.tactics_data.y
	local d_x = defender.tactics_data.x
	local d_y = defender.tactics_data.y
	local min_range = attacker.stats.min_range
	local max_range = attacker.stats.max_range
	local dist = abs(a_x-d_x)+abs(a_y-d_y)
	
	return dist >= min_range and dist <= max_range
end

function deal_damage(attacker, defender)
	defender:take_damage(attacker.stats.damage)
end

function is_alive(unit)
	return unit.stats.hp_current > 0
end

function can_counterattack(defender, attacker)
	return is_in_combat_range(defender, attacker)
			and is_alive(defender)
			and is_alive(attacker)
end

function try_attack(attacker, defender)
	local direction = atan2(
		attacker.tactics_data.x - defender.tactics_data.x,
		attacker.tactics_data.y - defender.tactics_data.y
	)		
	attacker:start_animation("BUMP", direction)
	while attacker.animation_playing do
		yield()
	end
	deal_damage(attacker, defender)
	defender:start_animation("HURT", direction + 0.5)
	while defender.animation_playing do
		yield()
	end
end

function do_combat(attacker, defender)
	start_routine(function()
		assert(is_in_combat_range(attacker, defender))
		
		try_attack(attacker, defender)
		
		if can_counterattack(defender, attacker) then
			try_attack(defender, attacker)
		end
	end)
end
:: draw.lua
--[[pod_format="raw",created="2025-11-19 02:54:58",modified="2025-11-19 04:30:10",revision=4]]


function draw_shadow(c, draw, x, y)
	for i=1,31 do
		pal(i, c)
	end
	draw(x-1, y)
	draw(x, y-1)
	draw(x+1, y)
	draw(x, y+1)
	pal()
end
:: main.lua
--[[pod_format="raw",created="2025-11-14 23:50:30",modified="2025-11-20 14:42:32",revision=33]]
-- tactics game
-- ynp

-- TODO LIST
-- unit stuff
--   enemy ai
-- animations
-- - walk to destination
-- - combat "bumps" + screenshake
-- opposing units are solid in dijkstra

-- PROTOTYPE GOALS
-- Fully random characters, no story
-- 3-5 levels, with units carrying over between levels, plus 1-2 recruits added per level
-- Maps made with player and enemy spawn points
-- Decent UI

-- LONG TERM TODO
-- character relationships
-- class progression
-- inheritence?

include "tactics.lua"
include "tasks.lua"

function _init()
  setup_battle({
  	width=20, height=15
  })
end
 
function _draw()
  cls(22)
  draw_tactics()
end
 
function get_joypad()
	local joy = {
		dx = (btn(1) or 0) - (btn(0) or 0),
		dxp = (btnp(1) and 1 or 0) - (btnp(0) and 1 or 0),
		dy = (btn(3) or 0) - (btn(2) or 0),
		dyp = (btnp(3) and 1 or 0) - (btnp(2) and 1 or 0),
		a = btn(4),
		ap = btnp(4),
		b = btn(5),
		bp = btnp(5)
	}
	
	return joy
end
 
function _update()
	local joy = get_joypad()
	update_tactics(joy)
	update_tasks()
end
:: tactics.lua
--[[pod_format="raw",created="2025-11-14 23:57:30",modified="2025-11-20 19:15:51",revision=293]]
include "util.lua"
include "tiles.lua"
include "character.lua"
include "combat.lua"
include "draw.lua"

local COLOR_MENU_PRIMARY = 32
local COLOR_MENU_SECONDARY = 7
local COLOR_MENU_TEXT = 7
local COLOR_MENU_HIGHLIGHT = 6
local COLOR_MENU_HIGHLIGHT_TEXT = 32

local MAP_OFFSET_X = 104
local MAP_OFFSET_Y = 12
local MAP_WIDTH = 15
local MAP_HEIGHT = 10
local TILE_WIDTH = 24
local TILE_HEIGHT = 24
local UNIT_OFFSET_X = 4
local UNIT_OFFSET_Y = 7
local CURSOR_SPRITE = 8

local TEXT_HEIGHT = 7

local SIDE_PLAYER = 0
local SIDE_ENEMY = 1

local units = {}
-- ensure units have unique ids
local index_counter = 1
-- map of [x][y] for each entity in the map
local tile_contents = {}

-- map_info
-- width
-- height

local CURSOR_GRID = 0
local CURSOR_VERTICAL_LIST = 1
local CURSOR_HORIZONTAL_LIST = 2

-- step data helpers

function get_unit_from_step(menu_state, step)
	return units[menu_state.selections[step].unit]
end

-- unit filters

function unit_is_player(unit)
	return unit.tactics_data.side == SIDE_PLAYER
end

function unit_is_enemy(unit)
	return unit.tactics_data.side == SIDE_ENEMY
end

-- grid filters

function tile_is_in_unit_movement_range(x, y, unit)

end

function tile_has_distance_from_unit(x1, y1, x2, y2, min_distance, max_distance)
	max_distance = max_distance or min_distance
	local distance = abs(x1-x2)+abs(y1-y2)
	return distance >= min_distance and distance <= max_distance
end

-- validators

function validate_tile_is_in_unit_attack_range(unit_step, position_step)
	return function(menu_state, active_cursor)
		local unit = get_unit_from_step(menu_state, unit_step)
		local min_distance = unit.stats.min_range
		local max_distance = unit.stats.max_range
		local destination = menu_state.selections[position_step]
		local unit_x = destination.x
		local unit_y = destination.y
		local target_x = active_cursor.x
		local target_y = active_cursor.y
		return tile_has_distance_from_unit(target_x, target_y, unit_x, unit_y, min_distance, max_distance)
	end
end

-- legal tile getters

function tiles_with_distance_from_unit_attacks(unit_step, position_step)
	return function(menu_state)
		local unit = get_unit_from_step(menu_state, unit_step)
		local min_distance = unit.stats.min_range
		local max_distance = unit.stats.max_range
		
		return tiles_with_distance_from_unit
			(position_step, min_distance, max_distance)
			(menu_state)
	end
end

function tiles_with_distance_from_unit(position_step, min_distance, max_distance)
	max_distance = max_distance or min_distance
	return function(menu_state)
		local destination = menu_state.selections[position_step]
		local dest_x = destination.x
		local dest_y = destination.y
		
		local reachable = {}
		for x=-max_distance,max_distance do
			local map_x = x + dest_x
			if map_x >= 0 and map_x < MAP_WIDTH then
				local abs_x = abs(x)
				local min_y_abs = max(0, min_distance-abs_x)
				local max_y_abs = max_distance-abs_x
				
				if max_y_abs >= min_y_abs then
					reachable[map_x] = {}
					for y=-max_y_abs,-min_y_abs do
						local map_y = y + dest_y
						if map_y >= 0 and map_y < MAP_HEIGHT then
							reachable[map_x][map_y] = true
						end
					end
					for y=min_y_abs,max_y_abs do
						local map_y = y + dest_y
						if map_y >= 0 and map_y < MAP_HEIGHT then
							reachable[map_x][map_y] = true
						end
					end
				end
			end
		end
	
		return reachable
	end
end

function tiles_in_movement_range(menu_state)
	local unit = menu_state.selections["SELECT_UNIT"].unit
	local unit_data = units[unit].tactics_data
	
	return find_reachable_tiles(unit_data.x, unit_data.y, 6)
end

-- select transitions

function no_change_transition(next_step)
	return function (menu_state, active_cursor)
		menu_state.menu_step = next_step
	end
end

function new_list_transition(next_step, next_kind)
	return function (menu_state, active_cursor)
		menu_state.menu_step = next_step
		active_cursor.i = 0
	end
end

-- selected data mappers

function selected_unit_mapper(filter)
	return function (active_cursor)
		local selected_unit = tile_contents[active_cursor.x][active_cursor.y]
		if selected_unit == nil then
			return false, nil
		end
		if filter ~= nil then
			if not filter(units[selected_unit]) then
				return false, nil
			end
		end
		return true, {unit = selected_unit}
	end
end

function selected_tile_mapper (active_cursor)
	return true, {x = active_cursor.x, y = active_cursor.y}
end

function selected_empty_tile_mapper (active_cursor)
	local selected_unit = tile_contents[active_cursor.x][active_cursor.y]
	if selected_unit == nil then
		return true, {x = active_cursor.x, y = active_cursor.y}
	end
	return false, nil
end

-- handlers

function handle_move_unit(menu_state, active_cursor)
	local selections = menu_state.selections

	local unit = get_unit_from_step(menu_state, "SELECT_UNIT")
	local x = selections["SELECT_DESTINATION"].x
	local y = selections["SELECT_DESTINATION"].y
	
	move_unit(unit, x, y)
	unit.tactics_data.has_acted = true
	
	set_menu("MENU_PLAYER_TURN")
end

function handle_move_and_attack(menu_state, active_cursor)
	local selections = menu_state.selections

	local unit = get_unit_from_step(menu_state, "SELECT_UNIT")
	local x = selections["SELECT_DESTINATION"].x
	local y = selections["SELECT_DESTINATION"].y
	local target = get_unit_from_step(menu_state, "SELECT_TARGET")
	
	move_unit(unit, x, y)
	do_combat(unit, target)
	unit.tactics_data.has_acted = true
	
	set_menu("MENU_PLAYER_TURN")
end

-- kind
-- selected_data_mapper -- returns (success bool, data) to store
-- select_transition
local MENU_DATA = {
	["MENU_PLAYER_TURN"] = {
		initial_step = "SELECT_UNIT",
		steps = {
			["SELECT_UNIT"] = {
				kind = CURSOR_GRID,
				selected_data_mapper = selected_unit_mapper(unit_is_player),
				select_transition = no_change_transition("SELECT_DESTINATION")
			},
			["SELECT_DESTINATION"] = {
				kind = CURSOR_GRID,
				selected_data_mapper = selected_empty_tile_mapper,
				select_transition = new_list_transition("SELECT_ACTION"),
				get_legal_tiles = tiles_in_movement_range
			},
			["SELECT_ACTION"] = {
				kind = CURSOR_VERTICAL_LIST,
				options = {
					[1] = {
						text = "Wait",
						select_transition = handle_move_unit
					},
					[2] = {
						text = "Attack",
						select_transition = no_change_transition("SELECT_TARGET")
					}
				}
			},
			["SELECT_TARGET"] = {
				kind = CURSOR_GRID,
				validator = validate_tile_is_in_unit_attack_range("SELECT_UNIT", "SELECT_DESTINATION"),
				selected_data_mapper = selected_unit_mapper(unit_is_enemy),
				select_transition = handle_move_and_attack,
				get_legal_tiles = tiles_with_distance_from_unit_attacks("SELECT_UNIT", "SELECT_DESTINATION")
			},
		}
	}
}

function handle_menu_select(menu_state, active_cursor)
	local menu_data = MENU_DATA[menu_state.menu_id]
	local step_data = menu_data.steps[menu_state.menu_step]
	
	if step_data.validator ~= nil then
		local validation = step_data.validator(menu_state, active_cursor)
		if not validation then return end
	end
	
	if step_data.options == nil then -- non-list transitions
		local success, data = step_data.selected_data_mapper(active_cursor)
	
		if not success then return end
		
		add(menu_state.step_history, menu_state.menu_step)
		menu_state.selections[menu_state.menu_step] = data
	
		step_data.select_transition(menu_state, active_cursor)
	else -- list transitions
		add(menu_state.step_history, menu_state.menu_step)
		menu_state.selections[menu_state.menu_step] = {i = active_cursor.i}
	
		step_data.options[active_cursor.i].select_transition(menu_state, active_cursor)
	end
	populate_menu_state(menu_state)
end

function populate_menu_state(menu_state)
	local menu_data = MENU_DATA[menu_state.menu_id]
	local new_step_data = menu_data.steps[menu_state.menu_step]
	menu_state.kind = new_step_data.kind
	if new_step_data.options ~= nil then
		menu_state.options = {}
		for k,o in pairs(new_step_data.options) do
			menu_state.options[k] = o.text
		end 
	end
	if new_step_data.get_legal_tiles ~= nil then
		menu_state.legal_tiles = new_step_data.get_legal_tiles(menu_state)
	end
end

function handle_menu_back(menu_state, active_cursor)
	local step_history = menu_state.step_history
	if #step_history == 0 then return end
	
	local previous_state = step_history[#step_history]
	-- TODO: use this to get last cursor position
	-- or, just push the entire active cursor onto a list
	menu_state.selections[previous_state] = nil
	menu_state.step_history[#step_history] = nil
	no_change_transition(previous_state)(menu_state, active_cursor)
	populate_menu_state(menu_state)
end

local active_cursor = {}
local menu_state = {}

local update_cursor = {
	[CURSOR_GRID] = function (menu_state, active_cursor, joy)
		active_cursor.x = mid(0, active_cursor.x + joy.dxp, menu_state.x_max - 1)
		active_cursor.y = mid(0, active_cursor.y + joy.dyp, menu_state.y_max - 1)
	end,
	[CURSOR_VERTICAL_LIST] = function (menu_state, active_cursor, joy)
		active_cursor.i = mid(1, active_cursor.i + joy.dyp, #menu_state.options)
	end,
	[CURSOR_HORIZONTAL_LIST] = function (menu_state, active_cursor, joy)
		active_cursor.i = mid(1, active_cursor.i + joy.dxp, #menu_state.options)
	end,
}

function setup_battle(map_info)
	tile_contents = {}
	for i=0,map_info.width do
		tile_contents[i] = {}
	end
	
	set_menu("MENU_PLAYER_TURN")
	
	for i = 0,3 do
		spawn_unit(generate_character(), 2 + i%2, 2+i*2, SIDE_PLAYER)
	end
	for i = 0,3 do
		spawn_unit(generate_character(), 7 + i%2, 3+i*2, SIDE_ENEMY)
	end
end

function set_menu(menu_id)
	-- TODO: make functional?
	menu_state = {
		kind = CURSOR_GRID,
		handle_back = nil,
		x_max = 20, -- TODO
		y_max = 15, -- TODO
		menu_id = menu_id,
		menu_step = MENU_DATA[menu_id].initial_step,
		selections = {},
		step_history = {}
	}
	active_cursor = {
		x = 0,
		y = 0
	}
end

function spawn_unit(unit, x, y, side)
	if tile_contents[x][y] ~= nil then
		error("Tried to spawn unit in an occupied tile! (".. x .. "," .. y .. ")")
	end
	
	local id = index_counter
	index_counter = index_counter + 1
	
	local tactics_data = {
		id = id,
		x = x,
		y = y,
		side = side,
		has_acted = false
	}
	unit.tactics_data = tactics_data
	units[id] = unit
	tile_contents[x][y] = id
end

function handle_select_grid_unit(active_cursor)
	local selected_tile = tile_contents[active_cursor.x][active_cursor.y]
	if selected_tile ~= nil then
		error(selected_tile)
	end
end

function update_tactics(joy)
	for unit in all(units) do
		unit:update_animation()
	end

	if joy.bp then
		handle_menu_back(menu_state, active_cursor)
	elseif joy.ap then
		handle_menu_select(menu_state, active_cursor)
	else
		update_cursor[menu_state.kind](menu_state, active_cursor, joy)
	end
end

function move_unit(unit, x, y)
	assert(tile_contents[x][y] == nil)
	
	-- TODO: animated movement
	
	tile_contents[unit.tactics_data.x][unit.tactics_data.y] = nil
	tile_contents[x][y] = unit.tactics_data.id
	unit.tactics_data.x = x
	unit.tactics_data.y = y
end

function draw_tactics()
	camera(-MAP_OFFSET_X, -MAP_OFFSET_Y)
	
	map(0, 0, 0, 0, MAP_WIDTH, MAP_HEIGHT, nil, TILE_WIDTH, TILE_HEIGHT)
	
	
	-- highlight legal tiles
	if menu_state.legal_tiles ~= nil then
		fillp(
		  0b01100110,
		  0b11001100,
		  0b10011001,
		  0b00110011,
		  0b01100110,
		  0b11001100,
		  0b10011001,
		  0b00110011
		)
		poke(0x550b,0x3f)
		palt()
		color(28)
		for x,v in pairs(menu_state.legal_tiles) do
			for y,is_legal in pairs(v) do
				if is_legal then
					rrectfill(x*TILE_WIDTH, y*TILE_HEIGHT, TILE_WIDTH, TILE_HEIGHT)
				end
			end
		end
		poke(0x550b,0x00)
		fillp()
		color()
	end
	
	for unit in all(units) do
		draw_unit(unit)
	end
	
	if active_cursor.x ~= nil and active_cursor.y ~= nil then
		local x = active_cursor.x * TILE_WIDTH
		local y = active_cursor.y * TILE_HEIGHT
		spr(CURSOR_SPRITE, x, y)
		
		if menu_state.kind == CURSOR_VERTICAL_LIST then
			local selected_i = active_cursor.i
			local options = menu_state.options
			local PADDING = 2
			
			local menu_x = x + TILE_WIDTH
			local menu_y = y + TILE_HEIGHT
			local menu_w = 2*PADDING + 30
			local menu_h = 2*PADDING + #options * (TEXT_HEIGHT+1) -1
			rrectfill(menu_x, menu_y, menu_w, menu_h, 1, COLOR_MENU_PRIMARY)
			for i,opt in ipairs(options) do
				if i == selected_i then
					rrectfill(menu_x, menu_y+PADDING-1+(TEXT_HEIGHT+1)*(i-1), menu_w, TEXT_HEIGHT+2, 0, COLOR_MENU_HIGHLIGHT)
					print(opt, menu_x+PADDING, menu_y+PADDING+(TEXT_HEIGHT+1)*(i-1), COLOR_MENU_HIGHLIGHT_TEXT)
				else
					print(opt, menu_x+PADDING, menu_y+PADDING+(TEXT_HEIGHT+1)*(i-1), COLOR_MENU_TEXT)				
				end
			end
			rrect(menu_x, menu_y, menu_w, menu_h, 1, COLOR_MENU_SECONDARY)
		end
	end
	
	camera()
	
	draw_tactics_debug()
end

function draw_unit(unit)
	local side = unit.tactics_data.side
	local x = unit.tactics_data.x
	local y = unit.tactics_data.y
	local s = unit.s
	local s = unit.tactics_data.side
	local has_acted = unit.tactics_data.has_acted
	
	local tile_x = x * TILE_WIDTH
	local tile_y = y * TILE_HEIGHT
	local flip_x = side ~= 0

	local shadow_color
	if has_acted then
		shadow_color = 0
	else
		shadow_color = 7
	end
	draw_shadow(shadow_color, 
		function(x,y) unit:draw(x, y, side, false) end,
		tile_x + UNIT_OFFSET_X, tile_y + UNIT_OFFSET_Y)		
	
	unit:draw(tile_x + UNIT_OFFSET_X, tile_y + UNIT_OFFSET_Y, side, true)
	
	local hp_current = unit.stats.hp_current
	local hp_max = unit.stats.hp_max
	draw_health_bar(hp_current, hp_max, tile_x+1, tile_y+1, TILE_WIDTH-2, 4)
end

function draw_health_bar(hp_current, hp_max, x, y, width, height)
	rrectfill(x, y, width, height, 1, COLOR_MENU_PRIMARY)
	local bar_width = flr(hp_current*(width-2) / hp_max)
	rrectfill(x+1, y+1, bar_width, height-2, 1, 27)
	rrect(x, y, width, height, 1, COLOR_MENU_SECONDARY)
end

function draw_tactics_debug()
	print(menu_state.menu_id, 3, 3, 1)
	print(menu_state.menu_step, 3, 11, 1)
	print("x: "..(active_cursor.x or "nil"), 3, 19, 1)
	print("y: "..(active_cursor.y or "nil"), 3, 27, 1)
	print("i: "..(active_cursor.i or "nil"), 3, 35, 1)
end
:: tasks.lua
--[[pod_format="raw",created="2025-11-20 00:37:21",modified="2025-11-20 01:34:02",revision=3]]
local tasks = {}

function start_routine(func)
    local co = cocreate(func)
    add(tasks, co)
end

function update_tasks()
    for co in all(tasks) do
        if costatus(co) == "suspended" then
            local ok, err = assert(coresume(co))
            if not ok then printh("Task Error: "..err) end
        elseif costatus(co) == "dead" then
            del(tasks, co)
        end
    end
end
:: tiles.lua
--[[pod_format="raw",created="2025-11-17 01:52:30",modified="2025-11-20 14:28:18",revision=28]]
-- tile flags:
-- 0: empty/solid
-- 1-3: terrain type
-- 0 default
-- 1 forest
-- 2 sand
-- 3 hill
-- 4 mountain
-- 5 shallow water
-- 6 deep water
-- 7 

-- not class-specific.  may revisit later
local terrain_costs = {
	[0] = 1,
	[1] = 2,
	[2] = 2,
	[3] = 3,
	[4] = 4,
	[5] = 3,
	[6] = 6,
	[7] = 2
}

-- cost to move onto x,y from any neighbor
function movement_cost(x, y)
	local tile = mget(x,y)
	if tile == nil then return 999 end
	
	local flags = fget(tile)
	local solid = (flags & 0b0001) == 0b0001
	local terrain = (flags & 0b1110) >> 1

	if solid then return 999 end
	return terrain_costs[terrain]
end

-- gemini, show me this man's dijkstra implementation
--- Finds all tiles reachable from a starting point within a given total cost.
--
-- @param start_x The x-coordinate of the starting tile.
-- @param start_y The y-coordinate of the starting tile.
-- @param total_cost The maximum cumulative cost allowed.
-- @return A table 'reachable' where reachable[x][y] = true for all reachable
--         tiles. Unreachable tiles will be nil.
function find_reachable_tiles(start_x, start_y, total_cost)
    -- min_cost[x][y] = cost: Stores the minimum cost found *so far* to reach (x, y).
    local min_cost = {}

    -- reachable[x][y] = true: Our output table.
    local reachable = {}

    -- A simple list acting as a priority queue.
    -- We will manually find the node with the minimum cost.
    -- Stores nodes as {x = x, y = y, cost = c}
    local priority_queue = {}

    -- Neighbor offsets (up, down, left, right)
    local neighbors = { {x=0, y=1}, {x=0, y=-1}, {x=1, y=0}, {x=-1, y=0} }

    -- --- Helper function to safely get values from our 2D min_cost table ---
    local function get_min_cost(x, y)
        if not min_cost[x] then
            return math.huge
        end
        return min_cost[x][y] or math.huge
    end

    -- --- Helper function to safely set values in our 2D min_cost table ---
    local function set_min_cost(x, y, cost)
        if not min_cost[x] then
            min_cost[x] = {}
        end
        min_cost[x][y] = cost
    end

    -- --- Initialization ---
    -- Get the cost of the starting tile itself.
    local start_tile_cost = 0

    -- If the start tile is impassable or costs more than our total, we can't go anywhere.
    if start_tile_cost > total_cost then
        return reachable -- Return the empty table
    end

    -- The cost to reach the start tile is its own movement cost.
    set_min_cost(start_x, start_y, start_tile_cost)

    -- Add the starting node to the priority queue.
    add(priority_queue, {x = start_x, y = start_y, cost = start_tile_cost})

    -- --- Main Algorithm Loop (Dijkstra's) ---
    while #priority_queue > 0 do
        -- 1. Find and remove the node with the minimum cost from the priority queue.
        -- (This is the inefficient part for a large map, but simple to implement)
        local min_node_cost = 999
        local min_index = -1
        for i, node in ipairs(priority_queue) do
            if node.cost < min_node_cost then
                min_node_cost = node.cost
                min_index = i
            end
        end

        -- Remove the node from the queue and get its data.
        local node = deli(priority_queue, min_index)
        local ux, uy, ucost = node.x, node.y, node.cost

        -- 2. Check for staleness. If we've already found a *better* path
        --    to this node, its cost will be higher than the one in min_cost.
        --    If so, we skip it.
        if ucost <= get_min_cost(ux, uy) then
            -- This is the cheapest path we've found to (ux, uy) so far.
            -- Mark it as reachable.
            if not reachable[ux] then
                reachable[ux] = {}
            end
            reachable[ux][uy] = true

            -- 3. Explore neighbors.
            for _, offset in ipairs(neighbors) do
                local vx, vy = ux + offset.x, uy + offset.y

                -- Calculate the cost to enter the neighbor tile...
                local cost_to_enter_v = movement_cost(vx, vy)
                -- ...and the new total cost to reach it from our current path.
                local new_cost_for_v = ucost + cost_to_enter_v

                -- 4. Check if this new path is valid (within budget).
                if new_cost_for_v <= total_cost then
                    -- 5. Check if this new path is *better* than any previous path
                    --    we found to this neighbor.
                    if new_cost_for_v < get_min_cost(vx, vy) then
                        -- It's a better path!
                        -- Record the new, lower cost.
                        set_min_cost(vx, vy, new_cost_for_v)
                        -- Add the neighbor to the queue to be explored.
                        add(priority_queue, {x = vx, y = vy, cost = new_cost_for_v})
                    end
                end
            end
        end
    end

    -- 6. Return the completed table of reachable tiles.
    return reachable
end
:: util.lua
--[[pod_format="raw",created="2025-11-16 19:20:13",modified="2025-11-20 14:42:34",revision=3]]

-- http://lua-users.org/wiki/CopyTable
function deepcopy(orig)
    local orig_type = type(orig)
    local copy
    if orig_type == 'table' then
        copy = {}
        for orig_key, orig_value in next, orig, nil do
            copy[deepcopy(orig_key)] = deepcopy(orig_value)
        end
        setmetatable(copy, deepcopy(getmetatable(orig)))
    else -- number, string, boolean, etc
        copy = orig
    end
    return copy
end

function rndi(i)
	return flr(rnd(i)//1)
end

function choose_random(...)
	local i = rndi(args.n)+1
	return args[i]
end

function choose_random_from_list(list)
	local i = rndi(#list)+1
	return list[i]
end
