local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local pairs = _tl_compat and _tl_compat.pairs or pairs; require("src/types")
require("src/util")
require("src/battle/tactics/battle_unit")

TerrainData = {}





local TERRAIN_DATA = {
   [0] = {
      movement_cost = 1,
      dodge = 0,
   },
   [1] = {
      movement_cost = 2,
      dodge = 0,
   },
   [2] = {
      movement_cost = 2,
      dodge = 0,
   },
   [3] = {
      movement_cost = 3,
      dodge = 0,
   },
   [4] = {
      movement_cost = 4,
      dodge = 0,
   },
   [5] = {
      movement_cost = 3,
      dodge = 0,
   },
   [6] = {
      movement_cost = 5,
      dodge = 0,
   },
   [7] = {
      movement_cost = 2,
      dodge = 0,
   },
}

MapLayers = {}







MapMetadata = {}




BattleMap = {}










function BattleMap.new(width, height)
   local self = setmetatable({
      units_by_id = {},
      units_by_x_y = Array2D.new(width, height),
   }, { __index = BattleMap })
   return self
end



function BattleMap:get_terrain(tile)
   local ground = self.layers.ground
   local back_wall = self.layers.back_wall
   local mid_wall = self.layers.mid_wall
   local front_wall = self.layers.front_wall

   local tile_sprite = ground:get(tile.x, tile.y)
   if tile_sprite == 0 then return nil end

   local flags = pt.fget(tile_sprite)
   local terrain = (flags & 0xD) >> 1
   local terrain_data = TERRAIN_DATA[terrain]

   local solid = flags & 0x1 == 0x1
   if back_wall then
      local back_wall_sprite = back_wall:get(tile.x, tile.y)
      if (pt.fget(back_wall_sprite) & 0x1) == 0x1 then
         solid = true
      end
   end
   if mid_wall then
      local mid_wall_sprite = mid_wall:get(tile.x, tile.y)
      if (pt.fget(mid_wall_sprite) & 0x1) == 0x1 then
         solid = true
      end
   end
   if front_wall then
      local front_wall_sprite = front_wall:get(tile.x, tile.y)
      if (pt.fget(front_wall_sprite) & 0x1) == 0x1 then
         solid = true
      end
   end

   return {
      solid = solid,
      movement_cost = terrain_data.movement_cost,
      dodge = terrain_data.dodge,
   }
end

function BattleMap:get_unit_by_id(id)
   return self.units_by_id[id]
end

function BattleMap:get_at_tile(tile)
   return self.units_by_x_y:get_point(tile)
end

function BattleMap:spawn_unit(unit, tile)
   if self:get_at_tile(tile) ~= nil then
      error("Tried to spawn unit in an occupied tile! (" .. tile.x .. "," .. tile.y .. ")")
   end

   local id = unit.id
   self.units_by_id[id] = unit
   self.units_by_x_y:set_point(tile, unit)
end

function BattleMap:tile_is_legal_destination(unit, tile)
   local unit_id_at_destination = self.units_by_x_y:get_point(tile)
   return (unit_id_at_destination == nil or
   unit_id_at_destination.id == unit.id)
end

function BattleMap:move_unit(unit, tile)
   assert(self:tile_is_legal_destination(unit, tile))

   self.units_by_x_y:set_point(unit.tile, nil)
   self.units_by_x_y:set_point(tile, unit)
   unit.tile = tile
end

function BattleMap:kill_unit(unit)
   self.units_by_x_y:set_point(unit.tile, nil)
   self.units_by_id[unit.id] = nil
   unit:die()
end





function BattleMap:tile_has_distance_from_tile(t1, t2, min_distance, max_distance)
   max_distance = max_distance or min_distance
   local distance = taxicab_distance(t1, t2)
   return distance >= min_distance and distance <= max_distance
end

function BattleMap:get_targets_in_range(unit_id, tile)
   local targets = {}
   local attacker = self.units_by_id[unit_id]
   local min_range, max_range = attacker.character:get_weapon_range()
   for _, target in pairs(self.units_by_id) do
      if target.id ~= attacker.id then
         if target.side ~= attacker.side and
            self:tile_has_distance_from_tile(
            tile,
            target.tile,
            min_range, max_range) then

            pt.add(targets, target)
         end
      end
   end
   return targets
end

function BattleMap:get_units(filter)
   local units = {}
   for _, unit in pairs(self.units_by_id) do
      if filter(unit) then
         pt.add(units, unit)
      end
   end
   return units
end

function BattleMap:get_all_units()
   return self:get_units(fn_true)
end

