function get_joypad()
   local joy = {

      dx = (pt.btn(1) and 1 or 0) - (pt.btn(0) and 1 or 0),
      dxp = (pt.btnp(1) and 1 or 0) - (pt.btnp(0) and 1 or 0),
      dy = (pt.btn(3) and 1 or 0) - (pt.btn(2) and 1 or 0),
      dyp = (pt.btnp(3) and 1 or 0) - (pt.btnp(2) and 1 or 0),
      a = pt.btn(4),
      ap = pt.btnp(4),
      b = pt.btn(5),
      bp = pt.btnp(5),
      lp = pt.btnp(14),
   }

   return joy
end

