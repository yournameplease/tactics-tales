MultipleOptionsMenuDefinition = {}









function MultipleOptionsMenuDefinition.new(props)
   props.type = "CURSOR_MULTIPLE_OPTIONS"
   return setmetatable(props, { __index = MultipleOptionsMenuDefinition })
end

function MultipleOptionsMenuCursor.new(step_definition, game_ctx, menu_ctx, menu_state)
   assert(step_definition.type == "CURSOR_MULTIPLE_OPTIONS")
   local self = {
      type = "CURSOR_MULTIPLE_OPTIONS",
      i = 0,
      options = List.do_map(
      step_definition.options,
      function(o)
         return {
            text = o.text,
            cursor = o.definition:to_cursor(game_ctx, menu_ctx, menu_state),
            must_select = o.must_select,
         }
      end),

   }
   return setmetatable(self, { __index = function(t, k)
      if (MultipleOptionsMenuCursor)[k] then
         return (MultipleOptionsMenuCursor)[k]
      end
      return (step_definition)[k]
   end,
   })
end

function MultipleOptionsMenuCursor:update_option(joy)
   local current_selection = self.options[self.i]
   if self.is_option_selected or not current_selection.must_select then
      current_selection.cursor:update(joy)
   end
end

function MultipleOptionsMenuCursor:update(joy)
   local new_i = self.i
   if self.primary_direction == "vertical" then
      if joy.dyp ~= 0 then
         new_i = new_i + joy.dyp
      else
         self:update_option(joy)
      end
   elseif self.primary_direction == "horizontal" then
      if joy.dxp ~= 0 then
         new_i = new_i + joy.dxp
      else
         self:update_option(joy)
      end
   elseif self.primary_direction == "select" then

   end

   if self.wrap then
      self.i = new_i % #self.options + 1
   else
      self.i = pt.mid(1, new_i, #self.options)
   end
end

function MultipleOptionsMenuCursor:handle_select(game_ctx, menu_ctx, menu_state)
   for _, opt in ipairs(self.options) do
      opt.cursor:handle_select(game_ctx, menu_ctx, menu_state)
   end

   return self.next_state, self.send_command
end

function MultipleOptionsMenuDefinition:to_cursor(game_context, menu_ctx, menu_state)
   return MultipleOptionsMenuCursor.new(self, game_context, menu_ctx, menu_state)
end

