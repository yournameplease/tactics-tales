:: build/ui/box.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/types")
require("src/battle/battle_context")
require("src/ui/ui_context_manager")
require("src/ui/theme")

Margin = {}






BoxDirection = {}




DecorationStyle = {}





UIElement = {}

























Box = {}




















function Box.new(props)
   local self = setmetatable({}, { __index = Box })
   self.x = props.x or 0
   self.y = props.y or 0
   self.w = props.w or 0
   self.h = props.h or 0


   if props.internal_margin ~= nil then
      self.internal_margin = {
         t = props.internal_margin.t or 0,
         b = props.internal_margin.b or 0,
         l = props.internal_margin.l or 0,
         r = props.internal_margin.r or 0,
      }
      self.decoration_padding = props.decoration_padding or 0
   else
      self.padding = props.padding or 2
      self.internal_margin = {
         t = self.padding,
         b = self.padding,
         l = self.padding,
         r = self.padding,
      }
      self.decoration_padding = props.decoration_padding or self.padding - 1
   end


   self.auto_width = props.auto_width or false
   self.auto_height = props.auto_height or false

   self.flex_grow = props.flex_grow or 0

   self.cross_stretch = props.cross_stretch ~= false


   self.dir = props.dir or "col"
   self.gap = props.gap or 1
   self.decoration = props.decoration
   self.transparent = props.transparent == true

   self.children = {}

   if self.decoration_padding < 0 then self.decoration_padding = 0 end

   assert(not (self.flex_grow > 0 and (self.auto_width and self.auto_height)), "Cannot flex grow with auto_width and auto_height")
   assert(
   self.decoration_padding == 0 or

   (
   self.decoration_padding < self.internal_margin.t and
   self.decoration_padding < self.internal_margin.b and
   self.decoration_padding < self.internal_margin.l and
   self.decoration_padding < self.internal_margin.r))


   return self
end



function Box.flex_col()
   return Box.new({ dir = "col", auto_width = true })
end

function Box.flex_row()
   return Box.new({ dir = "row", auto_width = true })
end


function Box.spacer()
   return Box.new({ flex_grow = 1 })
end

function Box:add(child)
   pt.add(self.children, child)
   return child
end





function Box:measure()


   if not self.auto_width and not self.auto_height then
      self._calculated_w = self.w
      self._calculated_h = self.h

      for _, child in ipairs(self.children) do
         if child.measure then child:measure() end
      end
      return
   end


   local content_w, content_h = 0, 0
   local is_row = (self.dir == "row")

   for i, child in ipairs(self.children) do



      if child.measure then
         child:measure()
      end


      local child_outer_w = (child._calculated_w or child.w)
      local child_outer_h = (child._calculated_h or child.h)

      if is_row then
         content_w = content_w + child_outer_w
         content_h = pt.max(content_h, child_outer_h)
         if i > 1 then content_w = content_w + self.gap end
      else
         content_w = pt.max(content_w, child_outer_w)
         content_h = content_h + child_outer_h
         if i > 1 then content_h = content_h + self.gap end
      end
   end


   self._calculated_w = self.auto_width and (content_w + self.internal_margin.l + self.internal_margin.r) or self.w
   self._calculated_h = self.auto_height and (content_h + self.internal_margin.t + self.internal_margin.b) or self.h
end





function Box:layout(parent_x, parent_y)

   local my_w = (self._calculated_w or self.w) - self.internal_margin.l - self.internal_margin.r
   local my_h = (self._calculated_h or self.h) - self.internal_margin.t - self.internal_margin.b



   self.x = parent_x or self.x
   self.y = parent_y or self.y

   local is_row = (self.dir == "row")


   local used_space = 0
   local total_flex = 0



   for i, child in ipairs(self.children) do

      if i > 1 then used_space = used_space + self.gap end




      if child.flex_grow > 0 and not (is_row and self.auto_width) and not (not is_row and self.auto_height) then
         total_flex = total_flex + child.flex_grow

      else
         local child_w = (child._calculated_w or child.w)
         local child_h = (child._calculated_h or child.h)

         if is_row then
            used_space = used_space + child_w
         else
            used_space = used_space + child_h
         end
      end
   end


   local cx = self.x + self.internal_margin.l
   local cy = self.y + self.internal_margin.t
   local total_size = is_row and my_w or my_h
   local remaining = pt.max(0, total_size - used_space)
   local px_per_flex = (total_flex > 0) and (remaining / total_flex) or 0

   for _, child in ipairs(self.children) do

      local child_w = child._calculated_w or child.w
      local child_h = child._calculated_h or child.h


      if child.flex_grow > 0 and total_flex > 0 then
         local added = pt.flr(child.flex_grow * px_per_flex)
         if is_row then child_w = added
         else child_h = added end
      end

      if self.cross_stretch then
         if is_row then
            child_h = self.h - self.internal_margin.t - self.internal_margin.b
         else
            child_w = self.w - self.internal_margin.l - self.internal_margin.r
         end
      end

      if child.layout then
         child.w, child.h = child_w, child_h
         child:layout(cx, cy)
      end


      if is_row then
         cx = cx + child_w + self.gap
         cy = cy
      else
         cy = cy + child_h + self.gap
         cx = cx
      end
   end
end

function Box:draw_shaded(color_ne, color_sw, color_interior)

   local x = self.x + self.internal_margin.l
   local y = self.y + self.internal_margin.t
   local w = self.w - (self.internal_margin.l + self.internal_margin.r)
   local h = self.h - (self.internal_margin.t + self.internal_margin.b)
   local pad = self.decoration_padding
   if pad ~= 0 then
      pt.rectfill(
      x,
      y + pad - 1,
      x + pad - 1,
      y + h - 1,
      color_sw)

      pt.rectfill(
      x,
      y + h - 1,
      x + w - 1,
      y + h - 1,
      color_sw)

      pt.rectfill(
      x,
      y,
      x + w - 1,
      y + pad - 1,
      color_ne)

      pt.rectfill(
      x + w - pad,
      y,
      x + w - 1,
      y + h - 1 - pad,
      color_ne)

   end
   pt.rectfill(
   x + pad,
   y + pad,
   x + w - 1 - pad,
   y + h - 1 - pad,
   color_interior)

end

function Box:draw_shaded_dividers(color_ne, color_sw, color_interior)

   local x = self.x + self.internal_margin.l
   local y = self.y + self.internal_margin.t
   local w = self.w - (self.internal_margin.l + self.internal_margin.r)
   local h = self.h - (self.internal_margin.t + self.internal_margin.b)
   local pad = self.decoration_padding

   if #self.children > 1 and self.gap > 2 * self.decoration_padding then
      for i = 2, #self.children do



























         if self.dir == "col" then
            local child = self.children[i]
            local c_y = child.y + child.internal_margin.t
            local gap_h = self.gap
            pt.rectfill(
            x,
            c_y - gap_h + pad,
            x + w - 1,
            c_y - pad,
            color_interior)

            pt.rectfill(
            x,
            c_y - gap_h,
            x + w - 1,
            c_y - gap_h + pad - 1,
            color_sw)

            pt.rectfill(
            x,
            c_y - pad + 1,
            x + w - 1,
            c_y,
            color_ne)

         elseif self.dir == "row" then
            local prev_child = self.children[i]
            local next_child = self.children[i]
            local c_x = next_child.x + next_child.internal_margin.l
            local gap_w = self.gap
            local y_prev = prev_child.y + prev_child.internal_margin.t
            local h_prev = prev_child.h
            local y_next = next_child.y + next_child.internal_margin.t
            local h_next = next_child.h
            pt.rectfill(
            c_x - gap_w + pad,
            y,
            c_x - pad,
            y + h - 1,
            color_interior)

            pt.rectfill(
            c_x - gap_w,
            y_prev,
            c_x - gap_w + pad - 1,
            h_prev + h_prev - 1,
            color_sw)

            pt.rectfill(
            c_x - pad + 1,
            y_next,
            c_x,
            y_next + h_next - 1,
            color_ne)

         end
      end
   end
end

function Box:draw_embossed(ui_theme)
   self:draw_shaded(ui_theme.COLOR_DECORATION_HIGHLIGHT, ui_theme.COLOR_DECORATION_SHADOW, ui_theme.COLOR_DECORATION_PRIMARY)
end

function Box:draw_recessed(ui_theme)
   self:draw_shaded(ui_theme.COLOR_DECORATION_SHADOW, ui_theme.COLOR_DECORATION_HIGHLIGHT, ui_theme.COLOR_INTERIOR)
   self:draw_shaded_dividers(ui_theme.COLOR_DECORATION_SHADOW, ui_theme.COLOR_DECORATION_HIGHLIGHT, ui_theme.COLOR_DECORATION_PRIMARY)
end

function Box:draw_border(ui_theme)
   local d_pad = self.decoration_padding
   local x = self.x + self.internal_margin.l - d_pad
   local y = self.y + self.internal_margin.t - d_pad
   local w = self.w - (self.internal_margin.l + self.internal_margin.r - 2 * d_pad)
   local h = self.h - (self.internal_margin.t + self.internal_margin.b - 2 * d_pad)
   local r = pt.max(0, d_pad - 1)
   pt.rrect(x, y, w, h, r, ui_theme.COLOR_DECORATION_PRIMARY)
end

function Box:draw_solid(ui_theme)
   local x = self.x
   local y = self.y
   local w = self.w
   local h = self.h
   pt.rrectfill(x, y, w, h, 0, ui_theme.COLOR_INTERIOR)
end

function Box._draw(self, state, ui_theme)
   local box = self

   if not box.transparent then
      box:draw_solid(ui_theme)
   end

   if box.decoration == 'embossed' then
      box:draw_embossed(ui_theme)
   elseif box.decoration == 'recessed' then
      box:draw_recessed(ui_theme)
   elseif box.decoration == 'border' then
      box:draw_border(ui_theme)
   end

















   for _, child in ipairs(box.children) do
      child:draw(state, ui_theme)
   end
end

function Box:draw(state, ui_theme)
   Box._draw(self, state, ui_theme)
end

return Box

:: build/ui/components/message_log.lua
require("src/ui/box")
require("src/ui/components/text_node")
require("src/ui/ui_context_manager")
local Text = require("src/util/text")

MessageLog = {}









function MessageLog.new(props)
   local box = Box.new(props)
   setmetatable(box, { __index = MessageLog })

   box.padding = props.padding or 1
   box.decoration_padding = 0
   box.func = props.func or error("Need text getter `func`")

   props.draw_properties = props.draw_properties or {}
   box.draw_properties = box.draw_properties or {
      justify = "left",
      text_direction = "up",
      wrap_mode = "wrap",
   }
   box.draw_properties.justify = props.draw_properties.justify or box.draw_properties.justify
   box.draw_properties.text_direction = props.draw_properties.text_direction or box.draw_properties.text_direction
   box.draw_properties.wrap_mode = box.draw_properties.wrap_mode

   return box
end

function MessageLog:draw(state, ui_theme)
   Box._draw(self, state, ui_theme)

   local text = self.func(state, 999)







   Text.draw(text,
   self.x + self.internal_margin.l,
   self.y + self.internal_margin.t,
   self.w - self.internal_margin.l - self.internal_margin.r,
   self.h - self.internal_margin.t - self.internal_margin.b,
   ui_theme.COLOR_INTERIOR_TEXT, self.draw_properties)
end

setmetatable(MessageLog, { __index = Box })

return MessageLog

:: build/ui/components/text_node.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; require("src/ui/ui_context_manager")
require("src/ui/box")
local Text = require("src/util/text")

TextUIElement = {}





TextNode = {}






setmetatable(TextNode, { __index = Box })

local TEXT_HEIGHT = 8





function TextNode.new(props)
   local box = Box.new(props)
   setmetatable(box, { __index = TextNode })

   box.padding = props.padding or 0
   box.decoration_padding = 0
   if props.text then
      box.text = props.text
   elseif props.func then
      box.func = props.func
   else
      error("Need either `text` or `func` for text node!")
   end
   if props.rows then
      box.rows = props.rows
      box.h = (box.rows) * (TEXT_HEIGHT + 2)
   end

   props.draw_properties = props.draw_properties or {}
   box.draw_properties = {
      justify = "left",
      text_direction = "down",
      wrap_mode = "ellipsis",
   }
   box.draw_properties.justify = props.draw_properties.justify or box.draw_properties.justify
   box.draw_properties.text_direction = props.draw_properties.text_direction or box.draw_properties.text_direction
   box.draw_properties.wrap_mode = box.draw_properties.wrap_mode

   return box
end

function TextNode:draw(state, ui_theme)
   Box._draw(self, state, ui_theme)

   local text = self.text or self.func(state)

   if self.rows then
      assert(
      #text ==
      self.rows, "`func` should return expected number of rows")

   end

   Text.draw(text,
   self.x + self.internal_margin.l,
   self.y + self.internal_margin.t,
   self.w - self.internal_margin.l - self.internal_margin.r,
   self.h - self.internal_margin.t - self.internal_margin.b,
   ui_theme.COLOR_INTERIOR_TEXT, self.draw_properties)
end

return TextNode

:: build/ui/decoration/page_divider.lua
require("src/ui/box")
require("src/ui/ui_context_manager")

local PageDivider = {}



setmetatable(PageDivider, { __index = Box })


function PageDivider.new(width)
   local box = Box.new({ w = width, cross_stretch = true })
   setmetatable(box, { __index = PageDivider })
   return box
end

function PageDivider:draw(state, ui_theme)


   local l = self.x
   local r = self.x + self.w - 1
   local t = self.y
   local b = self.y + self.h

   local w = ((self.w + 1) >> 1) - 1
   for i = 0, w do

      local c_l = i & 1 == 0 and ui_theme.COLOR_DECORATION_PRIMARY or ui_theme.COLOR_DECORATION_HIGHLIGHT
      local c_r = i & 1 == 0 and ui_theme.COLOR_DECORATION_PRIMARY or ui_theme.COLOR_DECORATION_HIGHLIGHT

      pt.line(l + i, t + i, l + i, b, c_l)
      if i < w or w & 1 == 0 then
         pt.line(r - i, t + i, r - i, b, c_r)
      end
   end
end

return PageDivider

