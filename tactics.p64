:: build/ui/panels/portrait_box.lua
require("src/types")
require("src/ui/ui_context_manager")
require("src/ui/box")
local CharacterRenderer = require("src/character/character_renderer")
local Colors = require("src/colors")

PortraitBox = {}




setmetatable(PortraitBox, { __index = Box })

local FEET_ANCHOR = AnimationAnchorPoint.of(11, 22)

function PortraitBox.new(get_selected_unit)
   local box = Box.new({
      w = 24, h = 28,
      padding = 4,
      decoration_padding = 3,
      decoration = 'border',
   })
   setmetatable(box, { __index = PortraitBox })
   box.get_selected_unit = get_selected_unit
   return box
end

function PortraitBox:draw(state, ui_theme)
   Box._draw(self, state, ui_theme)

   local unit = self.get_selected_unit(state)
   if unit then
      local shadow_color = ui_theme.COLOR_DECORATION_SHADOW
      draw_shadow(shadow_color,
      function(draw_x, draw_y)
         local draw_pos = DrawPoint.of(draw_x, draw_y)
         CharacterRenderer.draw(unit, (FEET_ANCHOR + draw_pos), unit.side, false, false)
      end,
      self.x, self.y)

      Colors.apply_palette("paper")
      local self_pos = DrawPoint.of(self.x, self.y)
      CharacterRenderer.draw(unit, (FEET_ANCHOR + self_pos), unit.side, false, false)
      pt.reset_pal()
   end
end

return PortraitBox

