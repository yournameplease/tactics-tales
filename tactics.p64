:: build/util/list.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs

local List = { MapEntry = {} }






function List.MapEntry.of(k, v)
   return {
      key = k,
      value = v,
   }
end

function List.do_pipeline(list, ...)
   local fns = { ... }
   local result = list
   for _, fn in ipairs(fns) do
      result = fn(result)
   end
   return result
end









function List.do_reverse(list)
   local out = {}
   for i = 1, #list do
      out[#list - i + 1] = list[i]
   end
   return out
end

function List.reverse()
   return function(list)
      return List.do_reverse(list)
   end
end

function List.do_filter(list, filter)
   local out = {}
   for _, v in ipairs(list) do
      if filter(v) then
         pt.add(out, v)
      end
   end
   return out
end

function List.filter(filter)
   return function(list)
      return List.do_filter(list, filter)
   end
end

function List.do_map(list, fn)
   local out = {}
   for k, v in ipairs(list) do
      out[k] = fn(v)
   end
   return out
end

function List.map(fn)
   return function(list)
      return List.do_map(list, fn)
   end
end

function List.do_reduce(list, initial, fn)
   local val = initial
   for _, e in ipairs(list) do
      val = fn(val, e)
   end
   return val
end

function List.reduce(initial, fn)
   return function(list)
      return List.do_reduce(list, initial, fn)
   end
end

function List.do_sum(list, fn)
   return List.do_reduce(list, 0, function(s, a) return s + fn(a) end)
end

function List.sum(fn)
   return function(list)
      return List.do_sum(list, fn)
   end
end

function List.do_collect_map(list)
   return List.do_reduce(list, {}, function(acc, entry)
      acc[entry.key] = entry.value
      return acc
   end)
end

function List.collect_map()
   return function(list)
      return List.do_collect_map(list)
   end
end

return List

:: build/util/random.lua
require("src/util")
local List = require("src/util/list")

Randomizer = {}





WeightedOption = {}




function WeightedOption.of(value, weight)
   return setmetatable({
      value = value,
      weight = weight,
   }, { __index = WeightedOption })
end

WeightedOptionSelector = {}





function WeightedOptionSelector.of(...)
   local array = { ... }
   local options = tmap(array, function(v) return { value = v, weight = 1 } end)
   return setmetatable({
      options = options,
      total_weight = #array,
   }, { __index = WeightedOptionSelector })
end

function WeightedOptionSelector.of_weighted(...)
   local array = { ... }
   return setmetatable({
      options = array,
      total_weight = sum(array, function(o) return o.weight end),
   }, { __index = WeightedOptionSelector })
end

function WeightedOptionSelector:pick_random()
   local i = rndi(self.total_weight) + 1
   if #self.options == self.total_weight then
      return self.options[i].value
   end
   local index = 0
   repeat
      index = index + 1
      i = i - self.options[index].weight
   until i <= 0
   return self.options[index].value
end



ListSelector = {}




function ListSelector.of_randomizers(...)
   local selectors = { ... }
   return setmetatable({
      selectors = selectors,
   }, { __index = ListSelector })
end

function ListSelector:pick_random()
   return List.do_map(
   self.selectors,
   function(r) return r:pick_random() end)

end



RandomRange = {}





function RandomRange.between(min_value, max_value)
   return setmetatable({
      min_value = min_value,
      max_value = max_value,
   }, { __index = RandomRange })
end

function RandomRange.of(n)
   return RandomRange.between(0, n - 1)
end

function RandomRange:pick_random()
   return self.min_value + rndi(self.max_value - self.min_value)
end

