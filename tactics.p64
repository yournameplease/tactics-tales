local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/debug")

require("src/types")
require("src/systems/event_bus")
require("src/systems/tasks")

require("src/data/battles")

require("src/battle/battle_state")
require("src/battle/tactics/battle_unit")
require("src/battle/tile_manager")
require("src/battle/tactics/tactics_engine")
require("src/battle/map/map_manager")
require("src/menu/menu_manager")
require("src/character/character_manager")

local SIDE_PLAYER = 0
local SIDE_ENEMY = 1

BattleManager = {}












function BattleManager:_spawn_unit(unit, spawn_point, side)
   local battle_unit = BattleUnit.spawn(unit, spawn_point, side)
   local idle_animation = self.animation_manager:create_idle_animation()
   battle_unit.animation_data = idle_animation
   self.battle_state:spawn_unit(battle_unit, spawn_point)
end


function BattleManager:_spawn_enemies(enemies, enemy_spawners)
   for i, enemy in ipairs(enemies) do
      local spawners = enemy_spawners[i]
      assert(spawners)
      for _, spawn_point in ipairs(enemy_spawners[i]) do

         local character = self.character_manager:generate_character(enemy.template)
         self:_spawn_unit(character, spawn_point, SIDE_ENEMY)
      end
   end
end

function BattleManager:_spawn_players(player_spawners)
   for id, spawn_point in ipairs(player_spawners) do

      local character = self.character_manager:generate_character("default")
      self:_spawn_unit(character, spawn_point, SIDE_PLAYER)
   end
end




function BattleManager.new(battle_id, event_bus, character_manager, animation_manager, task_manager)
   local battle_definition = BATTLE_DATA[battle_id]
   assert(battle_definition ~= nil)

   local self = setmetatable({}, { __index = BattleManager })

   self.event_bus = event_bus
   self.animation_manager = animation_manager
   self.task_manager = task_manager

   self.character_manager = character_manager

   self.map_data = MapManager:load_map(battle_definition.map_id)

   self.battle_state = BattleState.new(self.map_data.width, self.map_data.height)

   self.tile_manager = TileManager.new(self.map_data, self.battle_state)

   self:_spawn_enemies(battle_definition.enemies, self.map_data.metadata.enemy_spawners)
   self:_spawn_players(self.map_data.metadata.player_spawners)

   self.tactics_engine = TacticsEngine.new(self.battle_state, self.tile_manager, self.event_bus, self.animation_manager, self.task_manager)

   return self
end

function BattleManager:update()
   self.tactics_engine:update()
end

BattleFinishState = {}





function BattleManager:check_for_end()
   if self.tactics_engine:is_blocked() then
      return { finished = false }
   end

   local players = self.battle_state:get_units(unit_is_player)
   local enemies = self.battle_state:get_units(unit_is_enemy)

   if (#players == 0) then
      return { finished = true, command = "BATTLE_END_VICTORY" }
   elseif (#enemies == 0) then
      return { finished = true, command = "BATTLE_END_DEFEAT" }
   else
      return { finished = false }
   end
end



function BattleManager:check_objectives()

   return self:check_for_end()
end

return BattleManager

:: build/battle/battle_state.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local pairs = _tl_compat and _tl_compat.pairs or pairs; require("src/types")
require("src/util")
require("src/battle/tactics/battle_unit")

BattleState = {}




function BattleState.new(width, height)
   local self = setmetatable({}, { __index = BattleState })
   self.units_by_id = {}

   self.units_by_x_y = Array2D.new(width, height)
   return self
end




function BattleState:get_unit_by_id(id)
   return self.units_by_id[id]
end

function BattleState:get_at_tile(tile)
   return self.units_by_x_y:get_point(tile)
end

function BattleState:spawn_unit(unit, tile)
   if self:get_at_tile(tile) ~= nil then
      error("Tried to spawn unit in an occupied tile! (" .. tile.x .. "," .. tile.y .. ")")
   end

   local id = unit.id
   self.units_by_id[id] = unit
   self.units_by_x_y:set_point(tile, unit)
end

function BattleState:tile_is_legal_destination(unit, tile)
   local unit_id_at_destination = self.units_by_x_y:get_point(tile)
   return (unit_id_at_destination == nil or
   unit_id_at_destination.id == unit.id)
end

function BattleState:move_unit(unit, tile)
   assert(self:tile_is_legal_destination(unit, tile))

   self.units_by_x_y:set_point(unit.tile, nil)
   self.units_by_x_y:set_point(tile, unit)
   unit.tile = tile
end

function BattleState:kill_unit(unit)
   self.units_by_x_y:set_point(unit.tile, nil)
   self.units_by_id[unit.id] = nil
   unit:die()
end





function BattleState:tile_has_distance_from_tile(t1, t2, min_distance, max_distance)
   max_distance = max_distance or min_distance
   local distance = taxicab_distance(t1, t2)
   return distance >= min_distance and distance <= max_distance
end

function BattleState:get_targets_in_range(unit_id, tile)
   local targets = {}
   local attacker = self.units_by_id[unit_id]
   local min_range, max_range = attacker.character:get_weapon_range()
   for _, target in pairs(self.units_by_id) do
      if target.id ~= attacker.id then
         if target.side ~= attacker.side and
            self:tile_has_distance_from_tile(
            tile,
            target.tile,
            min_range, max_range) then

            add(targets, target)
         end
      end
   end
   return targets
end

function BattleState:get_units(filter)
   local units = {}
   for _, unit in pairs(self.units_by_id) do
      if filter(unit) then
         add(units, unit)
      end
   end
   return units
end

function BattleState:get_all_units()
   return self:get_units(fn_true)
end


return BattleState

:: build/battle/combat/combat_calculator.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; local pairs = _tl_compat and _tl_compat.pairs or pairs; require("src/battle/tactics/battle_unit")
require("src/battle/tile_manager")
require("src/debug")
local List = require("src/util/list")



CombatCalculator = {}



function CombatCalculator.new(tile_manager)
   local self = setmetatable({
      tile_manager = tile_manager,
   }, { __index = CombatCalculator })
   return self
end


















function CombatCalculator:build_attack_double(weapon, unit)
   local double = {
      damage = weapon.damage,
      accuracy = weapon.accuracy,
      min_range = weapon.min_range,
      max_range = weapon.max_range,
   }
   return double
end

function CombatCalculator:build_combat_double(unit)
   local double = {
      tile = unit.tile,
      hp_current = unit.hp_current,
      hp_max = unit.character.stats.hp_max,
      defense = {},
      avoid = {},
      attacks = List.do_map(
      unit.character.inventory:get_equipped_weapons(),
      function(weapon)
         return self:build_attack_double(weapon, unit)
      end),

      unit = unit,
   }

   local equipped_items = unit.character.inventory:get_equipped_items()

   for _slot, item in pairs(equipped_items) do
      for _, effect in ipairs(item:get_equipment_effects()) do


         if effect.type == "increase_defense" then
            double.defense[effect.defense_type] = (double.defense[effect.defense_type] or 0) + effect.amount
         end

         if effect.type == "increase_avoid" then
            double.avoid[effect.avoid_type] = (double.avoid[effect.avoid_type] or 0) + effect.amount
         end

         if effect.type == "long_reach" then

         end

         if effect.type == "shieldsplitter" then

         end

         if effect.type == "armorkiller" then

         end

      end
   end

   return double
end

function CombatCalculator:get_hit_chance(attacker, defender, weapon)
   local accuracy = weapon.accuracy

   local terrain = self.tile_manager:get_terrain(defender.tile)
   local terrain_avoid = (terrain.dodge or 0)

   local unit_avoid = 0

   for type, amount in pairs(defender.avoid) do
      unit_avoid = unit_avoid + amount or 0
   end

   return mid(0, accuracy - unit_avoid - terrain_avoid, 100)
end

function CombatCalculator:get_damage(attacker, defender, weapon)
   local atk = weapon.damage
   local def = 0

   for type, amount in pairs(defender.defense) do
      def = def + amount or 0
   end

   local damage = mid(0, atk - def, 999)
   if atk > 0 and damage == 0 then
      damage = 1
   end
   return damage
end

function CombatCalculator:is_in_combat_range(attacker, defender, attack)

   local dist = taxicab_distance(attacker.tile, defender.tile)

   return dist >= attack.min_range and dist <= attack.max_range
end

function CombatCalculator:can_attack(attacker, defender, attack)
   return self:is_in_combat_range(attacker, defender, attack) and
   attacker.hp_current > 0 and
   defender.hp_current > 0
end

CombatStep = {}








CombatResult = {}



function CombatCalculator:get_combat_step(attacker, defender, weapon)
   if weapon ~= nil then
      local step = {
         attacker = attacker.unit,
         defender = defender.unit,
         hit_chance = self:get_hit_chance(attacker, defender, weapon),
         dmg = self:get_damage(attacker, defender, weapon),
         hit_roll = rndi(100),
      }
      step.is_hit = step.hit_roll < step.hit_chance
      return step
   end
   return nil
end

function CombatCalculator:compute_combat(attacker_unit, defender_unit)
   local result = { steps = {} }

   local attacker = self:build_combat_double(attacker_unit)
   local defender = self:build_combat_double(defender_unit)

   local attacker_attacks = attacker.attacks
   local defender_attacks = defender.attacks


   local step1 = self:get_combat_step(attacker, defender, attacker_attacks[1])
   if step1 ~= nil then
      add(result.steps, step1)
      if step1.is_hit then defender.hp_current = defender.hp_current - step1.dmg end
   end



   if self:can_attack(defender, attacker, defender_attacks[1]) and defender.hp_current > 0 then
      local step2 = self:get_combat_step(defender, attacker, defender_attacks[1])
      if step2 ~= nil then
         add(result.steps, step2)
      end
   end

   return result
end

CombatPreviewStep = {}






CombatPreviewResult = {}



function CombatCalculator:preview_combat(attacker_unit, defender_unit, attacker_tile)
   local result = { steps = {} }

   local attacker = self:build_combat_double(attacker_unit)
   attacker.tile = attacker_tile
   local defender = self:build_combat_double(defender_unit)

   local attacker_attacks = attacker.attacks
   local defender_attacks = defender.attacks


   local step1 = self:get_combat_step(attacker, defender, attacker_attacks[1])
   if step1 ~= nil then
      add(result.steps, step1)
   end



   if self:can_attack(defender, attacker, defender_attacks[1]) then
      local step2 = self:get_combat_step(defender, attacker, defender_attacks[1])
      if step2 ~= nil then
         add(result.steps, step2)
      end
   end

   return result
end

return CombatCalculator

:: build/battle/map/map_manager.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; require("src/types")
require("src/data/maps")

MapManager = {}



__MapFetchResultEntry = {}



MapFetchResult = {}

MapLayers = {}







MapMetadata = {}




MapData = {}






local BASE_PLAYER_SPAWNER_SPRITE = 0x408
local BASE_ENEMY_SPAWNER_SPRITE = 0x410
local BASE_REINFORCEMENT_SPAWNER_SPRITE = 0x418

local METATILES_LAYER = 1
local FRONT_WALL_LAYER = 2
local MID_WALL_LAYER = 3
local BACK_WALL_LAYER = 4
local GROUND_LAYER = 5



function MapManager:as_map(map_data)
   return {
      metatiles = map_data[METATILES_LAYER].bmp,
      front_wall = map_data[FRONT_WALL_LAYER].bmp,
      mid_wall = map_data[MID_WALL_LAYER].bmp,
      back_wall = map_data[BACK_WALL_LAYER].bmp,
      ground = map_data[GROUND_LAYER].bmp,
   }
end

function MapManager:apply_checkerboard(map_layers)
   local ground = map_layers.ground
   for x = 0, ground:height() - 1 do
      for y = 0, ground:width() - 1 do
         local tile = ground:get(x, y)
         if x + y & 1 == 0 and fget(tile) & 0x40 == 0x40 then
            ground:set(x, y, tile + 1)
         end
      end
   end
end

function MapManager:apply_default_walls(map_layers)
   local ground = map_layers.ground
   local back_wall = map_layers.back_wall
   local mid_wall = map_layers.mid_wall
   local front_wall = map_layers.front_wall
   for x = 0, ground:height() - 1 do
      for y = 0, ground:width() - 1 do
         local tile = ground:get(x, y)
         if fget(tile) & 0x80 == 0x80 then
            if back_wall:get(x, y) == 0 then
               back_wall:set(x, y, tile + 2)
            end
            if mid_wall:get(x, y) == 0 then
               mid_wall:set(x, y, tile + 2)
            end
            if front_wall:get(x, y) == 0 then
               front_wall:set(x, y, tile + 2)
            end
         end
      end
   end
end

function MapManager:_load_static(definition)
   local map_data = {}

   local map_fetch = fetch(DATP .. definition.file)

   map_data.layers = self:as_map(map_fetch)

   self:apply_checkerboard(map_data.layers)
   self:apply_default_walls(map_data.layers)

   local metatiles_layer = map_data.layers.metatiles
   map_data.width = metatiles_layer:width()
   map_data.height = metatiles_layer:height()
   map_data.metadata = {
      player_spawners = {},
      enemy_spawners = {},
   }

   for x = 0, metatiles_layer:height() - 1 do
      for y = 0, metatiles_layer:width() - 1 do
         local tile = metatiles_layer:get(x, y)
         if tile >= BASE_PLAYER_SPAWNER_SPRITE and tile < BASE_ENEMY_SPAWNER_SPRITE then
            local player_spawner_id = tile - BASE_PLAYER_SPAWNER_SPRITE + 1
            map_data.metadata.player_spawners[player_spawner_id] = TilePoint.of(x, y)
         elseif tile >= BASE_ENEMY_SPAWNER_SPRITE and tile < BASE_REINFORCEMENT_SPAWNER_SPRITE then
            local enemy_spawner_id = tile - BASE_ENEMY_SPAWNER_SPRITE + 1
            if map_data.metadata.enemy_spawners[enemy_spawner_id] == nil then
               map_data.metadata.enemy_spawners[enemy_spawner_id] = {}
            end
            add(map_data.metadata.enemy_spawners[enemy_spawner_id], TilePoint.of(x, y))
         end
      end
   end

   return map_data
end







function MapManager:load_map(map_id)
   local definition = MAP_DEFINITIONS[map_id]
   assert(definition ~= nil)

   local map_data
   if definition.type == "static" then
      map_data = self:_load_static(definition)


   end

   return map_data
end

return MapManager

:: build/battle/tactics/battle_unit.lua
require("src/debug")

require("src/animation")
require("src/types")
require("src/character/object/character")
require("src/character/items/object/weapon")



BattleUnit = {}


















function BattleUnit.spawn(permanent_unit, tile, side)
   local instance = {
      id = permanent_unit.id,
      tile = tile,
      side = side,
      hp_current = permanent_unit.stats.hp_max,
      has_acted = false,
      character = permanent_unit,
   }








   setmetatable(instance, { __index = BattleUnit })

   return instance
end

function BattleUnit:is_alive()
   return self.hp_current > 0
end

function BattleUnit:take_damage(amount)
   local new_hp = mid(0, self.hp_current - amount, self.character.stats.hp_max)
   self.hp_current = new_hp
end

function BattleUnit:die()
   LOG.info("Unit " .. self.id .. " is now dead")
end

return BattleUnit

:: build/battle/tactics/enemy_ai.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/debug")

require("src/menu/menu_manager")
require("src/battle/tactics/battle_unit")
require("src/battle/tile_manager")
require("src/battle/battle_manager")
require("src/battle/tactics/tactics_engine")
require("src/systems/event_bus")
require("src/systems/tasks")
require("src/battle/battle_state")










EnemyAIEngine = {}

















function EnemyAIEngine:compute_enemy_ai(unit)
   local tile_manager = self.battle_manager.tile_manager
   local all_tile_costs = tile_manager:calculate_all_tile_costs(unit.tile.x, unit.tile.y, unit.side, 999)

   local enemies = self.tactics_engine.battle_state:get_units(unit_is_player)

   local potential_attacks = {}
   local deep_moves = {}

   for _, e in ipairs(enemies) do
      local min_range, max_range = unit.character:get_weapon_range()
      local tiles_in_range = self.tactics_engine:find_tiles_with_distance_from_tile(e.tile.x, e.tile.y, min_range, max_range)
      tiles_in_range:foreachpoint(function(tile, in_range)
         if in_range then
            local shortest_path_tile = all_tile_costs:get_point(tile)
            if shortest_path_tile ~= nil then
               if shortest_path_tile.cost <= unit.character.stats.movement then
                  if self.battle_state:tile_is_legal_destination(unit, tile) then
                     add(potential_attacks, { destination = tile, target = e })
                  end
               else
                  add(deep_moves, { destination = tile })
               end
            end
         end
      end)
   end

   if #potential_attacks > 0 then
      local choice = potential_attacks[1]

      local destination = choice.destination
      local path = tile_manager:get_path_to_tile(all_tile_costs, destination)

      local action_ctx = {
         acting_unit = { unit = unit },
         destination = { point = destination, path = path },
         target_unit = { unit = choice.target },
      }
      LOG.info(unit.id .. " will attack " .. choice.target.id)
      self.event_bus:emit("MOVE_AND_ATTACK", action_ctx)
   elseif #deep_moves > 0 then
      local min_cost_deep_move = deep_moves[1]
      local min_cost = 999
      for _, deep_move in ipairs(deep_moves) do
         if all_tile_costs:get_point(deep_move.destination).cost < min_cost then
            min_cost = all_tile_costs:get_point(deep_move.destination).cost
            min_cost_deep_move = deep_move
         end
      end

      local point = min_cost_deep_move.destination
      while all_tile_costs:get_point(point).cost > unit.character.stats.movement or
         not self.battle_state:tile_is_legal_destination(unit, point) do
         point = all_tile_costs:get_point(point).prev
      end

      local path = tile_manager:get_path_to_tile(all_tile_costs, point)

      local action_ctx = {
         acting_unit = { unit = unit },
         destination = { point = point, path = path },
      }
      LOG.info(unit.id .. " will move to " .. point.x .. "," .. point.y)
      self.event_bus:emit("MOVE_AND_WAIT", action_ctx)
   else
      LOG.warn("WARN: No valid moves for " .. unit.id .. "!")
   end
end

function EnemyAIEngine:handle_enemy_turn()
   self.task_manager:start_routine(function()
      local enemies = self.battle_state:get_units(unit_is_enemy)

      for _, enemy in ipairs(enemies) do
         self:compute_enemy_ai(enemy)
         while self.tactics_engine:is_blocked() do
            yield()
         end
      end

      self.event_bus:emit("TACTICS_END_ENEMY_TURN")
   end)
end

function EnemyAIEngine.new(
   battle_manager,
   battle_state,
   tactics_engine,
   event_bus,
   task_manager,
   tile_manager)

   local self = setmetatable({}, { __index = EnemyAIEngine })

   self.battle_manager = battle_manager
   self.battle_state = battle_state
   self.tactics_engine = tactics_engine
   self.event_bus = event_bus
   self.task_manager = task_manager
   self.tile_manager = tile_manager

   self.event_bus:on("TACTICS_BEGIN_ENEMY_TURN", function() self:handle_enemy_turn() end)
   return self
end

return EnemyAIEngine

:: build/battle/tactics/tactics_engine.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/config")
require("src/debug")

require("src/menu/types")
require("src/menu/menu_selection")

require("src/util")
require("src/battle/tile_manager")
require("src/draw")
require("src/battle/combat/combat_calculator")
require("src/systems/event_bus")
require("src/systems/tasks")
require("src/animation")

require("src/battle/tactics/battle_unit")
require("src/menu/types")




local MAP_WIDTH = CONFIG.MAP_WIDTH
local MAP_HEIGHT = CONFIG.MAP_HEIGHT

local SIDE_PLAYER = 0
local SIDE_ENEMY = 1

TacticsEngine = {}





























function TacticsEngine.new(
   battle_state,
   tile_manager,
   event_bus,
   animation_manager,
   task_manager)

   local self = setmetatable({}, { __index = TacticsEngine })
   self.battle_is_blocked = false
   self.battle_state = battle_state
   self.tile_manager = tile_manager
   self.combat_calculator = CombatCalculator.new(tile_manager)
   self.event_bus = event_bus
   self.animation_manager = animation_manager
   self.task_manager = task_manager

   self.event_bus:on("MOVE_AND_WAIT", function(ctx)
      self:handle_move_unit(ctx)
   end)
   self.event_bus:on("MOVE_AND_ATTACK", function(ctx)
      self:handle_move_and_attack(ctx)
   end)
   self.event_bus:on("TACTICS_BEGIN_PLAYER_TURN", function(ctx)
      self.is_player_turn = true
   end)
   self.event_bus:on("TACTICS_END_PLAYER_TURN", function(ctx)
      self.is_player_turn = false
   end)

   LOG.debug("New battle.")
   return self
end



function TacticsEngine:handle_move_unit(ctx)
   local unit = ctx.acting_unit.unit
   local destination = ctx.destination.point
   local path = ctx.destination.path

   self.battle_is_blocked = true
   self.task_manager:start_routine(function()
      if #path > 1 then
         local animation = self.animation_manager:create_walk_animation(to_tile_path(path))
         unit.animation_data = animation
         LOG.debug("Animating!", animation.playing)
         while animation.playing do
            yield()
         end
      end

      self.battle_state:move_unit(unit, destination)
      unit.has_acted = true

      self.battle_is_blocked = false
      unit.animation_data = self.animation_manager:create_idle_animation()
      self.event_bus:emit("TACTICS_UNIT_END_ACTION")
   end)
end

function TacticsEngine:handle_move_and_attack(ctx)
   local unit = ctx.acting_unit.unit
   local destination = ctx.destination.point
   local path = ctx.destination.path
   local target = ctx.target_unit.unit

   self.battle_is_blocked = true
   self.task_manager:start_routine(function()
      if #path > 1 then
         local animation = self.animation_manager:create_walk_animation(to_tile_path(path))
         unit.animation_data = animation

         while animation.playing do
            yield()
         end
      end

      self.battle_state:move_unit(unit, destination)
      self:do_combat(unit, target)
      unit.has_acted = true

      self.battle_is_blocked = false
      LOG.debug("unblockiung battle")
      unit.animation_data = self.animation_manager:create_idle_animation()
      target.animation_data = self.animation_manager:create_idle_animation()
      self.event_bus:emit("TACTICS_UNIT_END_ACTION")
   end)
end



function TacticsEngine:apply_combat_step(step)
   local attacker = step.attacker
   local defender = step.defender

   local direction = atan2(
   defender.tile.x - attacker.tile.x,
   defender.tile.y - attacker.tile.y)


   local attack_animation = self.animation_manager:create_animation("BUMP", direction)
   attacker.animation_data = attack_animation
   if not step.is_hit then
      local dodge_animation = self.animation_manager:create_animation("DODGE", direction + 0.25)
      defender.animation_data = dodge_animation
      while dodge_animation.playing do
         yield()
      end
   end
   while attack_animation.playing do
      yield()
   end

   if step.is_hit then
      defender:take_damage(step.dmg)
      local hurt_animation = self.animation_manager:create_animation("HURT", direction + 0.5)
      defender.animation_data = hurt_animation

      while hurt_animation.playing do
         yield()
      end
   end

   if not defender:is_alive() then
      self.battle_state:kill_unit(defender)
   end
end

function TacticsEngine:do_combat(attacker, defender)
   local combat_result = self.combat_calculator:compute_combat(attacker, defender)

   for i, combat_step in ipairs(combat_result.steps) do
      LOG.debug("Combat step: ", i)
      self:apply_combat_step(combat_step)
   end
end



function TacticsEngine:refresh_all_units()
   self:refresh_units(fn_true)
end

function TacticsEngine:refresh_units(filter)
   local units_to_refresh = self.battle_state:get_units(filter)

   for _, unit in ipairs(units_to_refresh) do
      unit.has_acted = false
   end
end

function TacticsEngine:is_blocked()
   return self.battle_is_blocked
end



function unit_is_player(unit)
   return unit.side == SIDE_PLAYER
end

function unit_is_enemy(unit)
   return unit.side == SIDE_ENEMY
end



function TacticsEngine:validate_tile_is_in_unit_attack_range(selection, ctx)
   local unit = ctx.acting_unit.unit
   local destination = ctx.destination.point
   local min_range, max_range = unit.character:get_weapon_range()

   if selection.type == "CURSOR_GRID" then
      local target_point = selection.point

      local target_unit = self.battle_state:get_at_tile(target_point)
      if target_unit == nil then return false end

      if target_unit.side == unit.side then return false end

      return self.battle_state:tile_has_distance_from_tile(target_point, destination, min_range, max_range)
   end
   return false
end

function TacticsEngine:any_target_in_range(ctx)
   local unit = ctx.acting_unit.unit
   local destination = ctx.destination.point

   local units_in_range = self.battle_state:get_targets_in_range(unit.id, destination)
   return #units_in_range > 0
end




function TacticsEngine:tiles_with_distance_from_unit_attacks(ctx)
   local unit = ctx.acting_unit.unit
   local min_range, max_range = unit.character:get_weapon_range()

   local destination = ctx.destination.point
   local tiles_in_distance = self:find_tiles_with_distance_from_tile(destination.x, destination.y, min_range, max_range)

   local tiles = Array2D.new(MAP_WIDTH, MAP_HEIGHT)

   tiles_in_distance:foreach(function(x, y, in_range)
      if in_range then
         tiles:set(x, y, { can_attack = true, valid_selection = true })
      end
   end)

   return tiles
end


function TacticsEngine:find_tiles_with_distance_from_tile(tile_x, tile_y, min_distance, max_distance)
   max_distance = max_distance or min_distance

   local reachable = Array2D.new(MAP_WIDTH, MAP_HEIGHT, false)
   for x = -max_distance, max_distance do
      local map_x = x + tile_x
      if map_x >= 0 and map_x < MAP_WIDTH then
         local abs_x = abs(x)
         local min_y_abs = max(0, min_distance - abs_x)
         local max_y_abs = max_distance - abs_x

         if max_y_abs >= min_y_abs then
            for y = -max_y_abs, -min_y_abs do
               local map_y = y + tile_y
               if map_y >= 0 and map_y < MAP_HEIGHT then
                  reachable:set(map_x, map_y, true)
               end
            end
            for y = min_y_abs, max_y_abs do
               local map_y = y + tile_y
               if map_y >= 0 and map_y < MAP_HEIGHT then
                  reachable:set(map_x, map_y, true)
               end
            end
         end
      end
   end

   return reachable

end


function TacticsEngine:tiles_in_movement_and_attack_range(ctx)
   local unit = ctx.acting_unit.unit
   local min_range, max_range = unit.character:get_weapon_range()

   local reachable_tiles = self.tile_manager:find_reachable_tiles(unit.tile.x, unit.tile.y, unit.side, unit.character.stats.movement)

   local tiles = Array2D.new(MAP_WIDTH, MAP_HEIGHT)

   reachable_tiles:foreach(function(x, y, reachable)
      if reachable then
         local tile = tiles:get(x, y)
         if tile == nil then tile = {} end
         tile.reachable = true
         tile.valid_selection = true
         tiles:set(x, y, tile)
         local tiles_in_attack_range = self:find_tiles_with_distance_from_tile(x, y, min_range, max_range)

         tiles_in_attack_range:foreach(function(ax, ay, can_attack)
            if can_attack then
               local a_tile = tiles:get(ax, ay)
               if a_tile == nil then a_tile = {} end
               a_tile.can_attack = true
               tiles:set(ax, ay, a_tile)
            end
         end)
      end
   end)

   return tiles
end

function TacticsEngine:grid_selection_is_empty_or_acting_unit(grid_selection, ctx)
   assert(grid_selection.type == "CURSOR_GRID")
   local destination_unit = self.battle_state:get_at_tile(grid_selection.point)
   if destination_unit == nil then
      return true
   end
   local acting_unit = ctx.acting_unit.unit
   return destination_unit.id == acting_unit.id
end

function TacticsEngine:grid_selection_is_available_player(grid_selection)
   assert(grid_selection.type == "CURSOR_GRID")
   local unit = self.battle_state:get_at_tile(grid_selection.point)

   if unit == nil then return false end
   if unit.side ~= SIDE_PLAYER then return false end
   if unit.has_acted then return false end

   return true
end


function TacticsEngine:update()
   local blocking_animation = false
   local all_players_acted = true

   for _, unit in ipairs(self.battle_state:get_all_units()) do



      if unit.side == SIDE_PLAYER and not unit.has_acted then
         all_players_acted = false
      end
   end

   if blocking_animation then return end
   if self.is_player_turn and all_players_acted then
      self.event_bus:emit("TACTICS_END_PLAYER_TURN")
   end
end

return TacticsEngine

:: build/battle/tile_manager.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; local type = type; require("src/types")

require("src/util")
require("src/battle/battle_state")
require("src/battle/map/map_manager")













TerrainData = {}




local TERRAIN_DATA = {
   [0] = {
      movement_cost = 1,
      dodge = 0,
   },
   [1] = {
      movement_cost = 2,
      dodge = 0,
   },
   [2] = {
      movement_cost = 2,
      dodge = 0,
   },
   [3] = {
      movement_cost = 3,
      dodge = 0,
   },
   [4] = {
      movement_cost = 4,
      dodge = 0,
   },
   [5] = {
      movement_cost = 3,
      dodge = 0,
   },
   [6] = {
      movement_cost = 5,
      dodge = 0,
   },
   [7] = {
      movement_cost = 2,
      dodge = 0,
   },
}

TileManager = {}




function TileManager.new(map_data, battle_state)
   local self = setmetatable({}, { __index = TileManager })

   self.map_data = map_data
   self.battle_state = battle_state

   return self
end

function TileManager:get_terrain(tile)
   local tile_sprite = self.map_data.layers.ground:get(tile.x, tile.y)
   local flags = fget(tile_sprite)
   local terrain = (flags & 0xD) >> 1
   return TERRAIN_DATA[terrain]
end


function TileManager:movement_cost(tile, side)
   local ground = self.map_data.layers.ground
   local back_wall = self.map_data.layers.back_wall
   local mid_wall = self.map_data.layers.mid_wall
   local front_wall = self.map_data.layers.front_wall
   if tile.x < 0 or tile.y < 0 or tile.x >= ground:width() or tile.y >= ground:height() then
      return 999
   end

   local ground_sprite = ground:get(tile.x, tile.y)
   if tile == nil then return 999 end

   local unit = self.battle_state:get_at_tile(tile)
   if unit ~= nil then
      if unit.side ~= side then return 999 end
   end

   if back_wall then
      local back_wall_sprite = back_wall:get(tile.x, tile.y)
      if (fget(back_wall_sprite) & 0x1) == 0x1 then
         return 999
      end
   end
   if mid_wall then
      local mid_wall_sprite = mid_wall:get(tile.x, tile.y)
      if (fget(mid_wall_sprite) & 0x1) == 0x1 then
         return 999
      end
   end
   if front_wall then
      local front_wall_sprite = front_wall:get(tile.x, tile.y)
      if (fget(front_wall_sprite) & 0x1) == 0x1 then
         return 999
      end
   end

   local flags = fget(ground_sprite)
   local solid = (flags & 0x1) == 0x1
   local terrain = (flags & 0xD) >> 1

   if solid then return 999 end
   return TERRAIN_DATA[terrain].movement_cost
end



local NEIGHBORS = { { x = 0, y = 1 }, { x = 0, y = -1 }, { x = 1, y = 0 }, { x = -1, y = 0 } }

ShortestPathEntry = {}








function TileManager:_dijkstra_traversal(start_x, start_y, side, max_cost)

   local visited_info = Array2D.new(self.map_data.width, self.map_data.height)








   local priority_queue = {}


   local start_cost = 0

   visited_info:set(start_x, start_y, { cost = start_cost, prev = nil })
   add(priority_queue, { x = start_x, y = start_y, cost = start_cost })


   while #priority_queue > 0 do

      local min_node_cost = 999
      local min_index = -1

      for i, node in ipairs(priority_queue) do
         if node.cost < min_node_cost then
            min_node_cost = node.cost
            min_index = i
         end
      end

      local u = deli(priority_queue, min_index)
      assert(type(u) == "table")
      local ux, uy, ucost = u.x, u.y, u.cost

      LOG.trace("Processing shortest path point", ux, uy, ucost)


      local current_info = visited_info:get(ux, uy)
      if current_info and ucost <= current_info.cost then


         for _, offset in ipairs(NEIGHBORS) do
            local vx, vy = ux + offset.x, uy + offset.y


            local move_cost = self:movement_cost({ x = vx, y = vy }, side)
            assert(move_cost > 0, "0 cost moves not yet implemented.")


            if move_cost < 999 then
               local new_total = ucost + move_cost


               if new_total <= max_cost then
                  local neighbor_info = visited_info:get(vx, vy)


                  if not neighbor_info or new_total < neighbor_info.cost then

                     visited_info:set(vx, vy, { cost = new_total, prev = TilePoint.of(ux, uy) })
                     add(priority_queue, { x = vx, y = vy, cost = new_total })
                  end
               end
            end
         end
      end
   end

   return visited_info
end







function TileManager:calculate_all_tile_costs(start_x, start_y, side, max_limit)
   local limit = max_limit or 99999
   return self:_dijkstra_traversal(start_x, start_y, side, limit)
end


function TileManager:get_path_to_tile(all_tile_costs, tile)
   assert(all_tile_costs:get_point(tile) ~= nil)
   local path = {}
   add(path, tile:copy())
   local next_tile = tile
   while all_tile_costs:get_point(next_tile).prev ~= nil do
      next_tile = all_tile_costs:get_point(next_tile).prev
      add(path, next_tile:copy())
   end
   return reverse_list(path)
end



function TileManager:find_reachable_tiles(start_x, start_y, side, total_cost)

   local full_map = self:_dijkstra_traversal(start_x, start_y, side, total_cost)


   local reachable = Array2D.new(full_map.w, full_map.h, false)

   full_map:foreachpoint(
   function(tile, value)



      if (value.cost <= total_cost) then
         reachable:set_point(tile, true)
      end
   end)


   return reachable
end

return TileManager

