:: build/systems/event_bus.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; local pairs = _tl_compat and _tl_compat.pairs or pairs; require("src/systems/service")
require("src/util")
require("src/debug")

GameEvent = {}






















EventListener = {}




EventBus = {}







function EventBus:init(_service_manager, _services)

end

local MAX_EVENT_HISTORY = 99

function EventBus.new()
   local self = setmetatable({
      id = "event_bus",
      dependencies = {},
   }, { __index = EventBus })

   self.id_counter = IdCounter.new()
   self.event_history = {}
   self.listeners = {}
   return self
end

function EventBus:on(event_name, callback)
   if not self.listeners[event_name] then
      self.listeners[event_name] = {}
   end
   pt.add(self.listeners[event_name], {
      id = self.id_counter:get_id(),
      callback = callback,
   })
end

function EventBus:remove(id)

   for _, slots in pairs(self.listeners) do
      for i, listener in ipairs(slots) do
         if listener.id == id then
            pt.deli(slots, i)
            return
         end
      end
   end
   error("failed to remove listener")
end

function EventBus:remove_all(ids)
   for _, id in ipairs(ids) do
      self:remove(id)
   end
end

function EventBus:emit(event_name, args)
   LOG.debug("Recieved event", event_name)
   if #self.event_history > MAX_EVENT_HISTORY then
      pt.deli(self.event_history, 1)
   end
   pt.add(self.event_history, event_name)

   local slots = self.listeners[event_name]
   if slots then
      for _, listener in ipairs(slots) do
         listener.callback(args)
      end
   end
end

function EventBus:get_event_history()
   return self.event_history
end

return EventBus

:: build/systems/service.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; local pairs = _tl_compat and _tl_compat.pairs or pairs
ServiceId = {}



























GameService = {}






TransientGameService = {}



ServiceManager = {}






function ServiceManager:get_services()
   local out = {}
   for k, v in pairs(self.transient_services) do
      out[k] = v
   end
   for k, v in pairs(self.persistent_services) do
      out[k] = v
   end
   return out
end

function ServiceManager:assert_dependencies_exist(ids)
   for _, id in ipairs(ids) do
      if self.persistent_services[id] == nil and
         self.transient_services[id] == nil then
         error("Service '" .. id .. "' was expected but has not yet been initialized!")
      end
   end
   return true
end

function ServiceManager:register(service)
   local id = service.id
   assert(self.persistent_services[id] == nil)
   assert(self.transient_services[id] == nil)
   self:assert_dependencies_exist(service.dependencies)
   self.persistent_services[id] = service
   service:init(self, self:get_services())
   return service
end

function ServiceManager:register_transient(service)
   local id = service.id
   assert(self.persistent_services[id] == nil, "Persistent service " .. id .. " already exists!")
   assert(self.transient_services[id] == nil, "Transient service " .. id .. " already exists!")
   self:assert_dependencies_exist(service.dependencies)
   self.transient_services[id] = service
   service:init(self, self:get_services())
   return service
end

function ServiceManager:teardown_transient(service)
   local id = service.id
   assert(self.transient_services[id] ~= nil)
   service:teardown()
   self.transient_services[id] = nil
end

function ServiceManager:init(_service_manager, _services)
end

function ServiceManager.new()
   local self = {
      id = 'service_manager',
      dependencies = {},
   }
   setmetatable(self, { __index = ServiceManager })

   self.persistent_services = {}
   self.transient_services = {}

   self:init(self, {})
   self:register(self)
   return self
end


return {
   ServiceManager = ServiceManager,
}

