ListMenuDefinition = {}








function ListMenuDefinition.new(props)
   props.type = "CURSOR_LIST"
   return setmetatable(props, { __index = ListMenuDefinition })
end

function ListMenuDefinition.of_static_options(
   options,
   set_context_key,
   direction)

   local get_options = function(game_ctx, menu_context)
      return List.do_map(
      options,
      function(o)
         return {
            text = tostring(o),
         }
      end)

   end
   local set_selected_context = function(s, _msb, ctx)
      ctx.metadata[set_context_key] = options[s.i]
   end
   return ListMenuDefinition.new({
      set_selected_context = set_selected_context,
      get_options = get_options,
      wrap = false,
      direction = direction,
   })
end

function ListMenuCursor.new(step_definition, game_ctx, menu_ctx, menu_state)
   assert(step_definition.type == "CURSOR_LIST")
   local self = {
      type = "CURSOR_LIST",
      i = 1,
      options = step_definition.get_options(game_ctx, menu_ctx),
      direction = "vertical",
   }
   return setmetatable(self, { __index = function(t, k)
      if (ListMenuCursor)[k] then
         return (ListMenuCursor)[k]
      end
      return (step_definition)[k]
   end,
   })
end

function ListMenuCursor:update(joy)
   local new_i = self.i
   if self.direction == "vertical" then
      new_i = new_i + joy.dyp
   elseif self.direction == "horizontal" then
      new_i = new_i + joy.dxp
   else
      error()
   end

   if self.wrap then
      self.i = new_i % #self.options + 1
   else
      self.i = pt.mid(1, new_i, #self.options)
   end
end

function ListMenuCursor:handle_select(game_ctx, menu_ctx, menu_state)
   if self.set_selected_context ~= nil then
      self.set_selected_context(self, game_ctx, menu_ctx)
   end
   return self.options[self.i].next_state, self.options[self.i].send_command
end

function ListMenuDefinition:to_cursor(game_context, menu_ctx, menu_state)
   return ListMenuCursor.new(self, game_context, menu_ctx, menu_state)
end

