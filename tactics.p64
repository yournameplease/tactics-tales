local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/systems/service")
require("src/debug")

TaskManager = {}





function TaskManager:init(_service_manager, _services)
   self.tasks = {}
end

function TaskManager.new()
   return setmetatable({
      id = "task_manager",
      dependencies = {},
   }, { __index = TaskManager })
end

function TaskManager:start_routine(func)
   local co = pt.cocreate(func)
   pt.add(self.tasks, co)
end

function TaskManager:update_tasks()
   for _, co in ipairs(self.tasks) do
      if pt.costatus(co) == "suspended" then
         local ok, err = pt.coresume(co)
         if not ok then
            LOG.error("Task Error: " .. err)
            assert(ok)
         end
      elseif pt.costatus(co) == "dead" then
         pt.del(self.tasks, co)
      end
   end
end

:: build/turn_manager.lua
require("src/debug")

require("src/battle/tactics/enemy_ai")
require("src/battle/battle_menu_manager")
require("src/util/data_utils")
require("src/systems/event_bus")
require("src/battle/tactics/tactics_engine")
require("src/systems/service")
require("src/battle/battle_objective_service")
require("src/battle/battle_context")
require("src/systems/service/game_service_bundle")






TurnManager = {}








function TurnManager.new(ctx)
   local self = setmetatable({
      ctx = ctx,
   }, { __index = TurnManager })

   self.turn = 1
   self.phase = "PLAYER"

   self.event_listener_ids = {}

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_BEGIN_BATTLE", function()
      self.ctx.battle_menu_manager:set_menu("MENU_PLAYER_TURN")
      self.ctx.services.event_bus:emit("TACTICS_BEGIN_PLAYER_TURN")
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_UNIT_END_ACTION", function()
      if self.phase == "PLAYER" then
         LOG.debug("Setting to player turn menu")
         self.ctx.battle_menu_manager:set_menu("MENU_PLAYER_TURN")
      end
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_BEGIN_PLAYER_TURN", function()
      LOG.info("Begin player turn!")
      self.phase = "PLAYER"
      self.ctx.tactics_engine:refresh_all_units()
      self.ctx.battle_menu_manager:set_menu("MENU_PLAYER_TURN")
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_END_PLAYER_TURN", function()
      if self.phase ~= "PLAYER" then
         LOG.warn("Got message 'TACTICS_END_PLAYER_TURN', but phase was " .. self.phase .. ".  Ignoring message.")
         return
      end

      LOG.info("End player turn!")

      self.ctx.services.event_bus:emit("TACTICS_BEGIN_ENEMY_TURN", self.ctx.tactics_engine)
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_BEGIN_ENEMY_TURN", function()
      self.phase = "ENEMY"
      LOG.info("Begin enemy turn!")
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_END_ENEMY_TURN", function()
      if self.phase ~= "ENEMY" then
         LOG.warn("Got message 'TACTICS_END_ENEMY_TURN', but phase was " .. self.phase .. ".  Ignoring message.")
         return
      end
      LOG.info("End enemy turn!")

      self.turn = self.turn + 1

      local battle_result = self.ctx.battle_objective_service:check_for_end()

      if not battle_result.finished then
         self.ctx.services.event_bus:emit("TACTICS_BEGIN_PLAYER_TURN")
      else
         self.ctx.services.event_bus:emit(battle_result.command)
      end
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("BATTLE_END_VICTORY", function()
      LOG.info("You win!")
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("BATTLE_END_DEFEAT", function()
      LOG.info("You lose!")
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("MOVE_AND_WAIT", function(ctx)
      self.ctx.tactics_engine:handle_move_unit(ctx)
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("MOVE_AND_ATTACK", function(ctx)
      self.ctx.tactics_engine:handle_move_and_attack(ctx)
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_BEGIN_PLAYER_TURN", function()
      self.ctx.tactics_engine.is_player_turn = true
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_END_PLAYER_TURN", function()
      self.ctx.tactics_engine.is_player_turn = false
   end))

   pt.add(self.event_listener_ids, self.ctx.services.event_bus:on("TACTICS_BEGIN_ENEMY_TURN", function()
      self.ctx.enemy_ai_engine:handle_enemy_turn()
   end))

   return self
end

function TurnManager:teardown()
   self.ctx.services.event_bus:remove_all(self.event_listener_ids)
end

return TurnManager

:: build/types.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local type = type



Numerical = {}

Angle = {}

Color = {}

Point = {}













local BasePoint = {}



local base_point_mt = {
   __eq = function(a, b)
      return a.x == b.x and a.y == b.y
   end,
   __add = function(a, b)
      return BasePoint.of(a.x + b.x, a.y + b.y)
   end,
   __sub = function(a, b)
      return BasePoint.of(a.x - b.x, a.y - b.y)
   end,
   __mul = function(a, b)
      if type(a) == "number" then
         assert(type(b) == "table")
         return BasePoint.of(pt.flr(a * b.x), pt.flr(a * b.y))
      end
      if type(b) == "number" then
         assert(type(a) == "table")
         return BasePoint.of(pt.flr(a.x * b), pt.flr(a.y * b))
      end
      return BasePoint.of(a.x * b.x, a.y * b.y)
   end,
   __unm = function(p)
      return BasePoint.of(-p.x, -p.y)
   end,
   __tostring = function(p)
      return "(" .. p.x .. "," .. p.y .. ")"
   end,
   __index = BasePoint,
}

function BasePoint.of(x, y)
   return setmetatable({
      x = x,
      y = y,
   }, base_point_mt)
end

function BasePoint.of_angle(angle, scale)
   local x = pt.flr(scale * pt.cos(angle) + 0.5)
   local y = pt.flr(scale * pt.sin(angle) + 0.5)
   return BasePoint.of(x, y)
end

function BasePoint:copy()
   return setmetatable({
      x = self.x,
      y = self.y,
   }, base_point_mt)
end

setmetatable(BasePoint, base_point_mt)

ScalePoint = {}


setmetatable(ScalePoint, { __index = BasePoint })

TilePoint = {}


setmetatable(TilePoint, { __index = BasePoint })

WorldPoint = {}


setmetatable(WorldPoint, { __index = BasePoint })

AnimationOffset = {}


setmetatable(AnimationOffset, { __index = BasePoint })

AnimationAnchorPoint = {}


setmetatable(AnimationAnchorPoint, { __index = BasePoint })

DrawPoint = {}


setmetatable(DrawPoint, { __index = BasePoint })

function taxicab_distance(p1, p2)
   return pt.abs(p1.x - p2.x) + pt.abs(p1.y - p2.y)
end

