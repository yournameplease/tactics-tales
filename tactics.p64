:: build/ui/panels/message_log.lua
require("src/ui/box")
require("src/ui/panels/text_node")

MessageLog = {}




local TEXT_HEIGHT = 8
local TEXT_ROW_HEIGHT = TEXT_HEIGHT + 2





function MessageLog.new(props)
   local box = Box.new(props)
   setmetatable(box, { __index = MessageLog })

   box.padding = props.padding or 1
   box.decoration_padding = 0
   box.func = props.func or error("Need text getter `func`")
   if not box.auto_height then
      if props.rows then
         box.rows = props.rows or 1
         box.h = (box.rows) * (TEXT_HEIGHT + 2)
      elseif box.h then

      else
         error("Need height for MessageLog")
      end
   end
   box.justify = props.justify or "left"

   return box
end

function MessageLog:draw(state, ui_theme)
   Box._draw(self, state, ui_theme)

   local row_count = self.rows or flr(self.h / TEXT_ROW_HEIGHT)

   local text = self.func(state, row_count)


   local rows_to_render = min(row_count, #text)
   for i = 1, rows_to_render do
      draw_text_row(self, i, text[#text - i + 1], ui_theme)
   end

end

setmetatable(MessageLog, { __index = Box })

return MessageLog

:: build/ui/panels/portrait_box.lua
require("src/types")
require("src/ui/box")
local CharacterRenderer = require("src/character/character_renderer")
local Colors = require("src/colors")

PortraitBox = {}




setmetatable(PortraitBox, { __index = Box })

local FEET_ANCHOR = AnimationAnchorPoint.of(11, 22)

function PortraitBox.new(get_selected_unit)
   local box = Box.new({
      w = 24, h = 28,
      padding = 4,
      decoration_padding = 3,
      decoration = 'border',
   })
   setmetatable(box, { __index = PortraitBox })
   box.get_selected_unit = get_selected_unit
   return box
end

function PortraitBox:draw(state, ui_theme)
   Box._draw(self, state, ui_theme)

   local unit = self.get_selected_unit(state)
   if unit then
      local shadow_color = ui_theme.COLOR_DECORATION_SHADOW
      draw_shadow(shadow_color,
      function(draw_x, draw_y)
         local draw_pos = DrawPoint.of(draw_x, draw_y)
         CharacterRenderer.draw(unit, (FEET_ANCHOR + draw_pos), unit.side, false, false)
      end,
      self.x, self.y)

      Colors.apply_palette("paper")
      local self_pos = DrawPoint.of(self.x, self.y)
      CharacterRenderer.draw(unit, (FEET_ANCHOR + self_pos), unit.side, false, false)
      pal()
   end
end

return PortraitBox

:: build/ui/panels/tactics_map.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/debug")
require("src/config")

require("src/ui/box")
require("src/menu/menu_manager")
require("src/battle/battle_state")

local CharacterRenderer = require("src/character/character_renderer")

TacticsMap = {}





setmetatable(TacticsMap, { __index = Box })


local COLOR_MENU_PRIMARY = CONFIG.COLOR_MENU_PRIMARY
local COLOR_MENU_SECONDARY = CONFIG.COLOR_MENU_SECONDARY
local COLOR_MENU_TEXT = CONFIG.COLOR_MENU_TEXT
local COLOR_MENU_HIGHLIGHT = CONFIG.COLOR_MENU_HIGHLIGHT
local COLOR_MENU_HIGHLIGHT_TEXT = CONFIG.COLOR_MENU_HIGHLIGHT_TEXT

local MAP_WIDTH = CONFIG.MAP_WIDTH
local MAP_HEIGHT = CONFIG.MAP_HEIGHT
local TILE_SIZE = CONFIG.TILE_SIZE
local HALF_HEIGHT = TILE_SIZE.y >> 1


local UNIT_OFFSET_Y = -3
local CURSOR_SPRITE = 8

local TEXT_HEIGHT = 7

local FOOT_GROUND_ANCHOR = AnimationAnchorPoint.of(8, 12)

function TacticsMap.new(map_width, map_height, props)
   local box = Box.new(props)
   setmetatable(box, { __index = TacticsMap })

   box.map_width = map_width or MAP_WIDTH
   box.map_height = map_height or MAP_HEIGHT

   box.w = box.map_width * TILE_SIZE.x + box.internal_margin.l + box.internal_margin.r
   box.h = box.map_height * TILE_SIZE.y + box.internal_margin.t + box.internal_margin.b

   return box
end






local function compute_animated_unit_positions(battle_state)
   return tmap(
   battle_state:get_all_units(),
   function(unit)
      local animation_offset = CharacterRenderer.get_animation_offset(unit)
      return {
         id = unit.id,
         point = (unit.tile * TILE_SIZE + animation_offset),
      }
   end)

end

local function draw_health_bar(hp_current, hp_max, x, y, width, height)
   rrectfill(x, y, width, height, 1, COLOR_MENU_PRIMARY)
   local bar_width = flr(hp_current * (width - 2) / hp_max)
   rrectfill(x + 1, y + 1, bar_width, height - 2, 1, 27)
   rrect(x, y, width, height, 1, COLOR_MENU_SECONDARY)
end

local function draw_floating_menu(x, y, menu_selection)
   local selected_i = menu_selection.i
   local options = menu_selection.options
   local PADDING = 2

   local max_text_width = 0
   for _, opt in ipairs(options) do
      local text_width = print(opt.text, 0, -1000)
      max_text_width = max(max_text_width, text_width)
   end

   local menu_x = x + TILE_SIZE.x
   local menu_y = y + TILE_SIZE.y
   local menu_w = 2 * PADDING + max_text_width
   local menu_h = 2 * PADDING + #options * (TEXT_HEIGHT + 1) - 1
   rrectfill(menu_x, menu_y, menu_w, menu_h, 1, COLOR_MENU_PRIMARY)
   for i, opt in ipairs(options) do
      if i == selected_i then
         rrectfill(menu_x, menu_y + PADDING - 1 + (TEXT_HEIGHT + 1) * (i - 1), menu_w, TEXT_HEIGHT + 2, 0, COLOR_MENU_HIGHLIGHT)
         print(opt.text, menu_x + PADDING, menu_y + PADDING + (TEXT_HEIGHT + 1) * (i - 1), COLOR_MENU_HIGHLIGHT_TEXT)
      else
         print(opt.text, menu_x + PADDING, menu_y + PADDING + (TEXT_HEIGHT + 1) * (i - 1), COLOR_MENU_TEXT)
      end
   end
   rrect(menu_x, menu_y, menu_w, menu_h, 1, COLOR_MENU_SECONDARY)
end

local function draw_unit(unit)
   local side = unit.side
   local unit_tile = unit.tile


   local world_point = unit_tile * TILE_SIZE











   CharacterRenderer.draw(unit, world_point + FOOT_GROUND_ANCHOR, side, true, true)

   local hp_current = unit.hp_current
   local hp_max = unit.character.stats.hp_max

   draw_health_bar(hp_current, hp_max, world_point.x + 1, world_point.y + UNIT_OFFSET_Y - 5, TILE_SIZE.x - 2, 4)
end

function TacticsMap:draw(state, ui_theme)
   Box._draw(self, state, ui_theme)

   local battle_state = state.battle_state
   local menu = state.menu_manager

   local camera_x = self.x + self.internal_margin.l
   local camera_y = self.y + self.internal_margin.t
   camera(-camera_x, -camera_y)




   local unit_positions = compute_animated_unit_positions(state.battle_state)

   local sorted_units = userdata("i16", 2, #unit_positions)
   for i, u in ipairs(unit_positions) do
      sorted_units:set(0, i - 1, u.point.y)
      sorted_units:set(1, i - 1, u.id)
   end
   sorted_units:sort()

   local drawn_unit_count = 0

   local layers = state.battle_manager.map_data.layers
   local layer_ground = layers.ground
   local layer_wall_back = layers.back_wall
   local layer_wall_mid = layers.mid_wall
   local layer_wall_front = layers.front_wall

   local cursor_tile = nil
   local menu_selection = menu.menu_selection
   if menu_selection.type == "CURSOR_GRID" then
      cursor_tile = menu_selection.point
   elseif menu.menu_state.point ~= nil then
      cursor_tile = menu.menu_state.point
   end

   for y = 0, self.map_height - 1 do
      map(layer_wall_back, 0, y, 0, (y - 1) * TILE_SIZE.y, self.map_width, 1, nil, TILE_SIZE.x, TILE_SIZE.y)
      map(layer_ground, 0, y, 0, y * TILE_SIZE.y, self.map_width, 1, nil, TILE_SIZE.x, TILE_SIZE.y)


      if menu_selection.type == "CURSOR_GRID" then
         if menu_selection.legal_tiles ~= nil then
            fillp(










            0x33,
            0xCC,
            0x33,
            0xCC,
            0x33,
            0xCC,
            0x33,
            0xCC)

            poke(0x550b, 0x3f)
            palt()
            for x = 0, self.map_width - 1 do
               local highlighted_tile = menu_selection.legal_tiles:get(x, y)
               if highlighted_tile ~= nil and (highlighted_tile.reachable or highlighted_tile.can_attack) then
                  if (highlighted_tile.reachable) then
                     color(28)
                  elseif highlighted_tile.can_attack then
                     color(8)
                  else
                     error("invalid state")
                  end
                  rrectfill(x * TILE_SIZE.x + 1, y * TILE_SIZE.y + 1, TILE_SIZE.x - 2, TILE_SIZE.y - 2)
               end
            end
            poke(0x550b, 0x00)
            fillp()
            color()
         end
      end

      while drawn_unit_count < #unit_positions and sorted_units:get(0, drawn_unit_count) <= (y) * TILE_SIZE.y + HALF_HEIGHT do
         local unit_id = sorted_units:get(1, drawn_unit_count)
         local unit = battle_state:get_unit_by_id(unit_id)
         draw_unit(unit)
         drawn_unit_count = drawn_unit_count + 1
      end

      map(layer_wall_mid, 0, y, 0, y * TILE_SIZE.y - HALF_HEIGHT, self.map_width, 1, nil, TILE_SIZE.x, TILE_SIZE.y)

      while drawn_unit_count < #unit_positions and sorted_units:get(0, drawn_unit_count) <= (y + 1) * TILE_SIZE.y do
         local unit_id = sorted_units:get(1, drawn_unit_count)
         local unit = battle_state:get_unit_by_id(unit_id)
         draw_unit(unit)
         drawn_unit_count = drawn_unit_count + 1
      end


      if cursor_tile ~= nil then
         local c_x = cursor_tile.x * TILE_SIZE.x
         local c_y = cursor_tile.y * TILE_SIZE.y
         spr(CURSOR_SPRITE, c_x, c_y)
      end

      map(layer_wall_front, 0, y, 0, y * TILE_SIZE.y, self.map_width, 1, nil, TILE_SIZE.x, TILE_SIZE.y)
   end

   if cursor_tile ~= nil then
      local x = cursor_tile.x * TILE_SIZE.x
      local y = cursor_tile.y * TILE_SIZE.y
      spr(CURSOR_SPRITE, x, y)

      if menu_selection.type == "CURSOR_VERTICAL_LIST" then
         draw_floating_menu(x, y, menu_selection)
      end
   end

   camera()
end

return TacticsMap

:: build/ui/panels/text_node.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/ui/box")

TextJustify = {}





TextUIElement = {}





TextNode = {}




setmetatable(TextNode, { __index = Box })

local TEXT_HEIGHT = 8





function TextNode.new(props)
   local box = Box.new(props)
   setmetatable(box, { __index = TextNode })

   box.padding = props.padding or 0
   box.decoration_padding = 0
   box.func = props.func or error("Need text getter `func`")
   box.rows = props.rows or 1
   box.h = (box.rows) * (TEXT_HEIGHT + 2)
   box.justify = props.justify or "left"

   return box
end

function draw_text_row(self, i, text, ui_theme)
   local text_width = print(text, 0, -1000)

   local t_x
   if self.justify == "left" then
      t_x = self.x + self.padding + 1
   elseif self.justify == "center" then
      t_x = self.x + (self.w - 2 * (self.padding + 1) - text_width) // 2
   elseif self.justify == "right" then
      t_x = self.x + self.w - self.padding - 1 - text_width - 1
   else
      error("Unexpected value!")
   end

   print(text, t_x, self.y + self.padding + 1 + ((i - 1) * (TEXT_HEIGHT + 2)), ui_theme.COLOR_INTERIOR_TEXT)
end

function TextNode:draw(state, ui_theme)
   Box._draw(self, state, ui_theme)

   local text = self.func(state)

   assert(
   #text ==
   self.rows, "`func` should return expected number of rows")

   for i, text_row in ipairs(text) do
      draw_text_row(self, i, text_row, ui_theme)
   end

end

return TextNode

:: build/ui/panels/unit_info.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/ui/box")
require("src/ui/panels/text_node")
require("src/ui/panels/portrait_box")
require("src/character/items/object/item")
require("src/character/items/object/item_inventory")

UnitInfo = {}



setmetatable(UnitInfo, { __index = Box })

function UnitInfo.new(props)
   props.dir = "row"
   props.gap = props.gap or 4
   props.padding = props.padding or 4
   props.auto_height = props.auto_height or true

   local self = Box.new(props)
   setmetatable(self, { __index = UnitInfo })

   local left = self:add(Box.flex_col())
   left:add(PortraitBox.new(function(state) return state.hovered_unit end))
   left:add(Box.spacer())

   local info_col = self:add(Box.new({
      auto_height = true,
      dir = "col",
      gap = 2,
   }))


   info_col:add(TextNode.new({
      func = function(state)
         local u = state.hovered_unit
         if not u then return { "No Unit Selected" } end
         return { u.character.name .. " Lv." .. 1 }
      end,
   }))


   info_col:add(TextNode.new({
      rows = 3,
      func = function(state)
         local u = state.hovered_unit
         if not u then return { "", "", "" } end

         local weapons = u.character.inventory:get_equipped_weapons()

         local w
         if #weapons > 0 then
            w = weapons[1]
         end

         return {
            "HP: " .. u.hp_current .. "/" .. u.character.stats.hp_max,
            w and w.name or "Unarmed",
            w and ("(" .. w.accuracy .. "% for " .. w.damage .. " dmg)") or "",
         }
      end,
   }))

   info_col:add(TextNode.new({
      rows = 5,
      func = function(state)
         local u = state.hovered_unit
         if not u then return { "", "", "", "", "" } end

         local items = u.character.inventory:get_items()

         local out = { "Inventory:", "", "", "", "" }

         local index = 1
         for _, item in ipairs(items) do
            out[index + 1] = item:get_name()
            index = index + 1
            for _ = 2, item:get_slots() do
               out[index + 1] = " |"
               index = index + 1
            end
         end

         return out
      end,
   }))

   return self
end

return UnitInfo

:: build/ui/theme.lua
require("src/types")

UITheme = {}

:: build/ui/types.lua


UILayoutId = {}

:: build/ui/ui_manager.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local pairs = _tl_compat and _tl_compat.pairs or pairs; require("src/types")
require("src/ui/types")

require("src/game_context")
require("src/config")

require("src/ui/panels/tactics_map")
require("src/ui/box")
require("src/ui/panels/unit_info")
require("src/ui/panels/combat_preview")
require("src/ui/panels/text_node")
require("src/ui/panels/event_message_log")

local PageDivider = require("src/ui/decoration/page_divider")

require("src/ui/validator")

UILayout = {}



UIManager = {}






function UIManager.new()

   local self = setmetatable({}, { __index = UIManager })

   self.layouts = {}

   local battle_summary = Box.new({ x = 0, y = 0, auto_height = true, dir = "col", gap = 0, decoration = "border" })
   battle_summary:add(TextNode.new({ func = function(_state) return { "BATTLE" } end, justify = "center" }))
   battle_summary:add(TextNode.new({ func = function(state)
      local turn = state.turn_manager.turn
      return { "Turn " .. turn }
   end, justify = "center", }))
   battle_summary:add(TextNode.new({ func = function(_state) return { "Defeat all" } end, justify = "center" }))

   local page_divider = PageDivider.new(7)

   local tactics_map = TacticsMap.new(CONFIG.MAP_WIDTH, CONFIG.MAP_HEIGHT,
   {
      decoration_padding = 2,
      decoration = "border",
      internal_margin = { t = 5, b = 5, l = 4, r = 4 },
   })

   do
      local battle_root = Box.new({
         x = 0, y = 0,
         w = 480, h = 270,
         internal_margin = { t = 4 },
         gap = 0,
         padding = 0,
         dir = "row",
         transparent = true,
      })


      local left = battle_root:add(Box.new({ dir = "col", flex_grow = 1, padding = 2 }))
      left:add(battle_summary)
      left:add(UnitInfo.new({ padding = 2, decoration = "border" }))
      left:add(EventMessageLog.new({ padding = 2, flex_grow = 1, decoration = "border" }))

      battle_root:add(page_divider)
      battle_root:add(tactics_map)

      self.layouts["TACTICS"] = { root = battle_root }
   end
   do
      local battle_root = Box.new({
         x = 0, y = 0,
         w = 480, h = 270,
         internal_margin = { t = 4 },
         dir = "row",
         transparent = true,
      })


      local left = battle_root:add(Box.new({ dir = "col", flex_grow = 1, padding = 2 }))
      left:add(battle_summary)
      left:add(CombatPreview.new({ padding = 0, decoration = "border" }))
      left:add(EventMessageLog.new({ flex_grow = 1, decoration = "border" }))

      battle_root:add(page_divider)
      battle_root:add(tactics_map)

      self.layouts["COMBAT_PREVIEW"] = { root = battle_root }
   end


   for id, v in pairs(self.layouts) do
      MenuValidator.validate(v.root, id)
   end


   self.current_layout = self.layouts.TACTICS









   self.theme = {
      COLOR_DECORATION_PRIMARY = 4,
      COLOR_DECORATION_HIGHLIGHT = 31,
      COLOR_DECORATION_SHADOW = 20,
      COLOR_INTERIOR = 15,
      COLOR_INTERIOR_TEXT = 21,
      COLOR_CLEAR = 20,
   }

   return self
end

function UIManager:draw(game_context)
   self.current_layout = self.layouts[game_context.layout]

   local root = self.current_layout.root

   root:measure()
   root:layout(root.x, root.y)


   cls(self.theme.COLOR_CLEAR)
   root:draw(game_context, self.theme)
end

return UIManager

:: build/ui/validator.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; local string = _tl_compat and _tl_compat.string or string; require("src/ui/box")

MenuValidator = {}



local function get_node_name(_node, index)
   return ("child[" .. index .. "]")
end


function MenuValidator.validate(node, path)
   if not node then return end

   local is_col = (node.dir == "col")
   local is_row = (node.dir == "row")

   local children = node.children
   assert(children ~= nil)

   if node.auto_height then
      if is_col then
         assert(#children > 0, "LAYOUT ERROR: " .. path .. "\nMust have children to use auto_height.")
         for i, child in ipairs(children) do
            if (child.flex_grow or 0) > 0 then
               error(
               "LAYOUT ERROR: Circular Dependency.\nPath: " ..
               path .. " > " .. get_node_name(child, i) ..
               "Parent is 'auto_height' (col), but child has to 'flex_grow'.")

            end
         end
      end

      if is_row then
         for _, child in ipairs(children) do
            if child.cross_stretch and not child.h and not child.auto_height then
               error("Warning: " .. path .. "\nThis child effectively vanishes or relies on a sibling.")
            end
         end
      end
   end

   if node.auto_width then
      if is_row then
         assert(#children > 0, "LAYOUT ERROR: " .. path .. "\nMust have children to use auto_width.")
         for i, child in ipairs(children) do
            if (child.flex_grow or 0) > 0 then
               error(string.format(
               "LAYOUT ERROR: Circular Dependency.\nPath: %s > %s\nReason: Parent is 'auto_width' (row), but child tries to 'flex_grow'.",
               path, get_node_name(child, i)))

            end
         end
      end

      if is_row then
         for _, child in ipairs(children) do
            if child.cross_stretch and not child.w and not child.auto_width then
               error("Warning: " .. path .. "\nThis child effectively vanishes or relies on a sibling.")
            end
         end
      end
   end

   for i, child in ipairs(children) do
      local child_path = path .. " > " .. get_node_name(child, i)
      MenuValidator.validate(child, child_path)
   end
end

return MenuValidator

:: build/util.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; local pairs = _tl_compat and _tl_compat.pairs or pairs; require("src/types")

require("src/config")
















function rndi(i)
   return flr(rnd(i) // 1)
end






function choose_random_from_list(list)
   local i = rndi(#list) + 1
   return list[i]
end

function choose_random_from_table(tab)
   local list = {}
   for _, v in pairs(tab) do
      add(list, v)
   end
   return choose_random_from_list(list)
end

function reverse_list(list)
   local out = {}
   for i = 1, #list do
      out[#list - i + 1] = list[i]
   end
   return out
end

function fn_true()
   return true
end

function tmap(tab, fn)
   local out = {}
   for k, v in pairs(tab) do
      out[k] = fn(v)
   end
   return out
end

function reduce(list, initial, fn)
   local val = initial
   for _, e in ipairs(list) do
      val = fn(val, e)
   end
   return val
end

function sum(list, fn)
   return reduce(list, 0, function(s, a) return s + fn(a) end)
end



function to_tile_path(path)
   assert(#path > 0)


   local base_point = path[1]
   return tmap(path, function(p)
      return (p - base_point) * CONFIG.TILE_SIZE
   end)
end

function contains(tab, val)
   for _, v in ipairs(tab) do
      if v == val then
         return true
      end
   end
   return false
end

IdCounter = {}



function IdCounter:get_id()
   local id = self.id_count
   self.id_count = self.id_count + 1
   return id
end

function IdCounter.new()
   local counter = { id_count = 1 }
   setmetatable(counter, { __index = IdCounter })
   return counter
end



Array2D = {}





function Array2D.new(w, h, initial)
   local out = {
      w = w,
      h = h,
      _data = {},
   }
   for x = 1, w do
      out._data[x] = {}
      if initial ~= nil then
         for y = 1, h do
            out._data[x][y] = initial
         end
      end
   end
   setmetatable(out, { __index = Array2D })
   return out
end

function Array2D:get(x, y)
   assert(x >= 0 and y >= 0 and x < self.w and y < self.h)
   return self._data[x + 1][y + 1]
end

function Array2D:get_point(p)
   return self:get(p.x, p.y)
end

function Array2D:set(x, y, v)
   assert(x >= 0 and y >= 0 and x < self.w and y < self.h)
   self._data[x + 1][y + 1] = v
end

function Array2D:set_point(p, v)
   self:set(p.x, p.y, v)
end

function Array2D:foreach(fn)
   for x, col in pairs(self._data) do
      for y, v in pairs(col) do
         fn(x - 1, y - 1, v)
      end
   end
end

function Array2D:foreachpoint(fn)
   for x, col in pairs(self._data) do
      for y, v in pairs(col) do
         fn(TilePoint.of(x - 1, y - 1), v)
      end
   end
end

