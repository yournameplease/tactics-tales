:: build/ui/panels/combat_preview.lua
require("src/ui/box")
require("src/ui/components/text_node")
require("src/ui/panels/portrait_box")
require("src/ui/ui_context_manager")
require("src/battle/battle_context")
local CombatCalculator = require("src/battle/combat/combat_calculator")

CombatPreview = {}



setmetatable(CombatPreview, { __index = Box })

local function get_preview_text(state)
   local attacker = state.battle_context.acting_unit
   local defender = state.battle_context.hovered_unit
   local attacker_tile = state.battle_context.destination
   local battle_map = state.battle_context.ctx.battle_map
   local preview = CombatCalculator.preview_combat(attacker, defender, attacker_tile, battle_map).steps

   local out = {}
   if preview[1] ~= nil then
      pt.add(out, attacker.character.name .. " -> " .. defender.character.name)
      pt.add(out, "Hit: " .. preview[1].hit_chance .. "%")
      pt.add(out, "Dmg: " .. preview[1].dmg)
   else
      pt.add(out, "No attack!")
      pt.add(out, "")
      pt.add(out, "")

   end
   if preview[2] ~= nil then
      pt.add(out, attacker.character.name .. " <- " .. defender.character.name)
      pt.add(out, "Hit: " .. preview[2].hit_chance .. "%")
      pt.add(out, "Dmg: " .. preview[2].dmg)
   else
      pt.add(out, "No counterattack!")
      pt.add(out, "")
      pt.add(out, "")
   end
   return out
end

function CombatPreview.new(props)
   props.dir = "row"
   props.gap = props.gap or 4
   props.padding = props.padding or 4
   props.auto_height = props.auto_height or true

   local self = Box.new(props)
   setmetatable(self, { __index = CombatPreview })

   local attacker_portrait = PortraitBox.new(function(state) return state.battle_context.acting_unit end)
   local left = Box.flex_col()
   left:add(attacker_portrait)
   left:add(Box.spacer())
   local defender_portrait = PortraitBox.new(function(state) return state.battle_context.hovered_unit end)
   local right = Box.flex_col()
   right:add(defender_portrait)
   right:add(Box.spacer())

   local preview_text = TextNode.new({
      flex_grow = 1,
      rows = 6,
      func = get_preview_text,
   })

   self:add(left)
   self:add(preview_text)
   self:add(right)

   return self
end

return CombatPreview

