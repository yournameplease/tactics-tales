:: build/systems/event_bus.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/debug")

GameEvent = {}

















EventListener = {}

EventBus = {}




local MAX_EVENT_HISTORY = 99

function EventBus.new()
   local self = setmetatable({}, { __index = EventBus })
   self.event_history = {}
   self.listeners = {}
   return self
end

function EventBus:on(event_name, callback)
   if not self.listeners[event_name] then
      self.listeners[event_name] = {}
   end
   add(self.listeners[event_name], callback)
end

function EventBus:emit(event_name, args)
   LOG.debug("Recieved event", event_name)
   if #self.event_history > MAX_EVENT_HISTORY then
      deli(self.event_history, 1)
   end
   add(self.event_history, event_name)

   local slots = self.listeners[event_name]
   if slots then
      for _, callback in ipairs(slots) do
         callback(args)
      end
   end
end

function EventBus:get_event_history()
   return self.event_history
end

return EventBus

:: build/systems/tasks.lua
local _tl_compat; if (tonumber((_VERSION or ''):match('[%d.]*$')) or 0) < 5.3 then local p, m = pcall(require, 'compat53.module'); if p then _tl_compat = m end end; local assert = _tl_compat and _tl_compat.assert or assert; local ipairs = _tl_compat and _tl_compat.ipairs or ipairs; require("src/debug")

TaskManager = {}



function TaskManager.new()
   return setmetatable({ tasks = {} }, { __index = TaskManager })
end

function TaskManager:start_routine(func)
   local co = cocreate(func)
   add(self.tasks, co)
end

function TaskManager:update_tasks()
   for _, co in ipairs(self.tasks) do
      if costatus(co) == "suspended" then
         local ok, err = coresume(co)
         if not ok then
            LOG.error("Task Error: " .. err)
            assert(ok)
         end
      elseif costatus(co) == "dead" then
         del(self.tasks, co)
      end
   end
end

:: build/turn_manager.lua
require("src/debug")

require("src/battle/tactics/enemy_ai")
require("src/menu/menu_manager")
require("src/util/data_utils")
require("src/systems/event_bus")
require("src/battle/tactics/tactics_engine")
require("src/battle/battle_manager")






TurnManager = {}










function TurnManager.new(
   event_bus,
   tactics_engine,
   battle_manager,
   menu_manager,
   enemy_ai_engine)

   local self = setmetatable({}, { __index = TurnManager })

   self.turn = 1
   self.phase = "PLAYER"

   self.event_bus = event_bus
   self.tactics_engine = tactics_engine
   self.battle_manager = battle_manager
   self.menu_manager = menu_manager
   self.enemy_ai_engine = enemy_ai_engine

   self.event_bus:on("TACTICS_BEGIN_BATTLE", function()
      self.menu_manager:set_menu("MENU_PLAYER_TURN")
      self.event_bus:emit("TACTICS_BEGIN_PLAYER_TURN")
   end)

   self.event_bus:on("TACTICS_UNIT_END_ACTION", function()
      if self.phase == "PLAYER" then
         LOG.debug("Setting to player turn menu")
         self.menu_manager:set_menu("MENU_PLAYER_TURN")
      end
   end)

   self.event_bus:on("TACTICS_BEGIN_PLAYER_TURN", function()
      LOG.info("Begin player turn!")
      self.phase = "PLAYER"
      self.tactics_engine:refresh_all_units()
      self.menu_manager:set_menu("MENU_PLAYER_TURN")
   end)

   self.event_bus:on("TACTICS_END_PLAYER_TURN", function()
      if self.phase ~= "PLAYER" then
         LOG.warn("Got message 'TACTICS_END_PLAYER_TURN', but phase was " .. self.phase .. ".  Ignoring message.")
         return
      end

      LOG.info("End player turn!")

      self.event_bus:emit("TACTICS_BEGIN_ENEMY_TURN", self.tactics_engine)
   end)

   self.event_bus:on("TACTICS_BEGIN_ENEMY_TURN", function()
      self.phase = "ENEMY"
      LOG.info("Begin enemy turn!")
   end)

   self.event_bus:on("TACTICS_END_ENEMY_TURN", function()
      if self.phase ~= "ENEMY" then
         LOG.warn("Got message 'TACTICS_END_ENEMY_TURN', but phase was " .. self.phase .. ".  Ignoring message.")
         return
      end
      LOG.info("End enemy turn!")

      self.turn = self.turn + 1

      local battle_result = self.battle_manager:check_for_end()

      if not battle_result.finished then
         self.event_bus:emit("TACTICS_BEGIN_PLAYER_TURN")
      else
         self.event_bus:emit(battle_result.command)
      end
   end)

   self.event_bus:on("BATTLE_END_VICTORY", function()
      LOG.info("You win!")
   end)

   self.event_bus:on("BATTLE_END_DEFEAT", function()
      LOG.info("You lose!")
   end)

   return self
end

return TurnManager

